module test_support
  targets server
  trust none

use shield_client_hello.ext_alpn;
use shield_client_hello.ext_key_share;
use shield_client_hello.ext_server_name;
use shield_client_hello.ext_signature_algorithms;
use shield_client_hello.ext_supported_groups;
use shield_client_hello.ext_supported_versions;
use shield_client_hello.group_secp256r1;
use shield_client_hello.group_x25519;

// テスト共通支援関数

pub fn wrap_in_record(content_type: Int, version: Int, payload: &Bytes) -> Bytes
  intent "ペイロードを 5 バイトの TLS レコードヘッダで包む"
  requires none
  ensures none
  effects none
{
  let mut out = Bytes.with_capacity(5 + payload.byte_len());
  out.push(content_type);
  out.push(version / 256);
  out.push(version % 256);
  out.push(payload.byte_len() / 256);
  out.push(payload.byte_len() % 256);
  out.extend(&payload);
  return out;
}

pub fn build_valid_client_hello() -> Bytes
  intent "正常な TLS 1.3 ClientHello（ハンドシェイクヘッダ含む）を構築する"
  requires none
  ensures none
  effects none
{
  let mut payload = Bytes.new();

  // legacy_version: 0x0303
  payload.push(3);
  payload.push(3);

  // random: 32 bytes
  let mut i = 0;
  while i < 32 {
    payload.push(66);
    i = i + 1;
  }

  // legacy_session_id: 32 bytes
  payload.push(32);
  let mut s = 0;
  while s < 32 {
    payload.push(17);
    s = s + 1;
  }

  // cipher_suites: 3 suites (6 bytes: 0x1303, 0x1301, 0x1302)
  payload.push(0);
  payload.push(6);
  payload.push(19);
  payload.push(3);
  payload.push(19);
  payload.push(1);
  payload.push(19);
  payload.push(2);

  // legacy_compression_methods: [1, 0]
  payload.push(1);
  payload.push(0);

  // 拡張部
  let mut extensions = Bytes.new();

  // 1. supported_versions: 0x002b
  extensions.push(0);
  extensions.push(ext_supported_versions());
  extensions.push(0);
  extensions.push(3);
  extensions.push(2);
  extensions.push(3);
  extensions.push(4);

  // 2. server_name: 0x0000 ("example.com" = 11 bytes)
  let host = "example.com".as_bytes();
  let sn_list_len = 3 + host.byte_len();
  let ext_sn_len = sn_list_len + 2;
  extensions.push(0);
  extensions.push(ext_server_name());
  extensions.push(ext_sn_len / 256);
  extensions.push(ext_sn_len % 256);
  extensions.push(sn_list_len / 256);
  extensions.push(sn_list_len % 256);
  extensions.push(0);
  extensions.push(host.byte_len() / 256);
  extensions.push(host.byte_len() % 256);
  extensions.extend(&host);

  // 3. supported_groups: 0x000a (x25519, secp256r1)
  extensions.push(0);
  extensions.push(ext_supported_groups());
  extensions.push(0);
  extensions.push(6);
  extensions.push(0);
  extensions.push(4);
  extensions.push(0);
  extensions.push(group_x25519());
  extensions.push(0);
  extensions.push(group_secp256r1());

  // 4. key_share: 0x0033 (x25519 share = 32 bytes of 0x99)
  let mut key_data = Bytes.with_capacity(32);
  let mut k = 0;
  while k < 32 {
    key_data.push(153);
    k = k + 1;
  }
  let share_len = 4 + 32;
  let ext_ks_len = share_len + 2;
  extensions.push(0);
  extensions.push(ext_key_share());
  extensions.push(ext_ks_len / 256);
  extensions.push(ext_ks_len % 256);
  extensions.push(share_len / 256);
  extensions.push(share_len % 256);
  extensions.push(0);
  extensions.push(group_x25519());
  extensions.push(0);
  extensions.push(32);
  extensions.extend(&key_data);

  // 5. signature_algorithms: 0x000d (ecdsa_secp256r1_sha256 = 0x0403)
  extensions.push(0);
  extensions.push(ext_signature_algorithms());
  extensions.push(0);
  extensions.push(4);
  extensions.push(0);
  extensions.push(2);
  extensions.push(4);
  extensions.push(3);

  // 6. ALPN: 0x0010 ("http/1.1")
  let alpn = "http/1.1".as_bytes();
  let alpn_list_len = 1 + alpn.byte_len();
  let ext_alpn_len = alpn_list_len + 2;
  extensions.push(0);
  extensions.push(ext_alpn());
  extensions.push(ext_alpn_len / 256);
  extensions.push(ext_alpn_len % 256);
  extensions.push(alpn_list_len / 256);
  extensions.push(alpn_list_len % 256);
  extensions.push(alpn.byte_len());
  extensions.extend(&alpn);

  // 拡張長 + 拡張部を payload に追加
  payload.push(extensions.byte_len() / 256);
  payload.push(extensions.byte_len() % 256);
  payload.extend(&extensions);

  // ハンドシェイクヘッダ（4 バイト）
  let mut msg = Bytes.with_capacity(4 + payload.byte_len());
  msg.push(1);  // client_hello
  let plen = payload.byte_len();
  msg.push(plen / 65536);
  msg.push(plen / 256 % 256);
  msg.push(plen % 256);
  msg.extend(&payload);

  return msg;
}

pub struct FuzzRng {
  state: Int,
}

pub fn rng_new(seed: Int) -> FuzzRng
  intent "乱数生成器を初期化する"
  requires none
  ensures none
  effects none
{
  return FuzzRng { state: seed };
}

pub fn rng_next(rng: &mut FuzzRng) -> Int
  intent "線形合同法で非負の 31 ビット擬似乱数を生成する"
  requires none
  ensures none
  effects none
{
  let next_state = rng.state * 1103515245 + 12345 & 2147483647;
  rng.state = next_state;
  return next_state;
}

pub fn rng_below(rng: &mut FuzzRng, n: Int) -> Int
  intent "0 以上 n 未満の整数乱数を返す"
  requires none
  ensures none
  effects none
{
  if n <= 1 {
    return 0;
  }
  return rng_next(&mut rng) % n;
}

pub fn rng_random_bytes(rng: &mut FuzzRng, max_len: Int) -> Bytes
  intent "指定長までのランダムなバイト列を生成する"
  requires none
  ensures none
  effects none
{
  let len = rng_below(&mut rng, max_len + 1);
  let mut out = Bytes.with_capacity(len);
  let mut i = 0;
  while i < len {
    out.push(rng_next(&mut rng) % 256);
    i = i + 1;
  }
  return out;
}

pub fn rng_mutate(rng: &mut FuzzRng, data: &Bytes) -> Bytes
  intent "バイト列に変異を加える（ビット反転・置換・切り詰め）"
  requires none
  ensures none
  effects none
{
  if data.is_empty() {
    return rng_random_bytes(&mut rng, 16);
  }

  let mut out = data.clone();
  let ops = 1 + rng_below(&mut rng, 3);
  let mut op_idx = 0;

  while op_idx < ops {
    if out.is_empty() {
      out.push(rng_next(&mut rng) % 256);
    } else {
      let choice = rng_below(&mut rng, 3);
      if choice == 0 {
        // バイト置換
        let idx = rng_below(&mut rng, out.byte_len());
        let _ = out.set(idx, rng_next(&mut rng) % 256);
      } else if choice == 1 {
        // 1 ビット反転
        let idx = rng_below(&mut rng, out.byte_len());
        let cur = out.get(idx).unwrap_or(0);
        let bit = 1 << rng_below(&mut rng, 8);
        let _ = out.set(idx, cur ^ bit);
      } else {
        // 切り詰め
        let new_len = rng_below(&mut rng, out.byte_len());
        out = out.slice(0, new_len).unwrap_or(Bytes.new());
      }
    }
    op_idx = op_idx + 1;
  }

  return out;
}

fn hex_val(c: Int) -> Int
  intent "16 進文字コードを数値 (0-15) に変換する"
  requires none
  ensures none
  effects none
{
  if c >= 48 && c <= 57 {
    return c - 48;
  }
  if c >= 97 && c <= 102 {
    return c - 97 + 10;
  }
  if c >= 65 && c <= 70 {
    return c - 65 + 10;
  }
  return 0;
}

pub fn hex_decode(s: String) -> Bytes
  intent "16 進数文字列を Bytes にデコードする"
  requires none
  ensures none
  effects none
{
  let b = s.as_bytes();
  let mut out = Bytes.with_capacity(b.byte_len() / 2);
  let mut i = 0;
  while i + 1 < b.byte_len() {
    let h1 = hex_val(b.get(i).unwrap_or(0));
    let h2 = hex_val(b.get(i + 1).unwrap_or(0));
    out.push(h1 * 16 + h2);
    i = i + 2;
  }
  return out;
}

pub fn bytes_eq(a: &Bytes, b: &Bytes) -> Bool
  intent "2 つの Bytes が等しいか判定する"
  requires none
  ensures none
  effects none
{
  if a.byte_len() != b.byte_len() {
    return false;
  }
  let mut i = 0;
  while i < a.byte_len() {
    if a.get(i).unwrap_or(0) != b.get(i).unwrap_or(0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}
