  if !validate_limits(&l1).is_ok() {
    return false;
  }
  let l1024 = limits_with_max_handshaking_connections(&base, 1024);
  if !validate_limits(&l1024).is_ok() {
    return false;
  }
  let l1025 = limits_with_max_handshaking_connections(&base, 1025);
  if validate_limits(&l1025).is_ok() {
    return false;
  }
  return true;
}

