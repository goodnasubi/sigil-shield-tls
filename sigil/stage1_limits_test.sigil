module stage1_limits_test
  targets server
  trust none

use shield_limits.default_limits;
use shield_limits.limits_with_handshake_timeout_secs;
use shield_limits.limits_with_idle_timeout_secs;
use shield_limits.limits_with_max_concurrent_crypto_tasks;
use shield_limits.limits_with_max_connections;
use shield_limits.limits_with_max_connections_per_source;
use shield_limits.limits_with_max_handshaking_connections;
use shield_limits.limits_with_max_handshaking_per_source;
use shield_limits.limits_with_upstream_connect_timeout_secs;
use shield_limits.limits_with_write_timeout_secs;
use shield_limits.validate_limits;

// 資源上限の境界試験（ADR 0063 決定 4.5）

fn test_default() -> Bool
  intent "既定の設定が有効であることを確認する"
  requires none
  ensures none
  effects none
{
  let d = default_limits();
  return validate_limits(&d).is_ok();
}

fn test_connections() -> Bool
  intent "同時接続数の境界試験"
  requires none
  ensures none
  effects none
{
  let base = default_limits();
  let l0 = limits_with_max_connections(&base, 0);
  if validate_limits(&l0).is_ok() {
    return false;
  }
  let l1 = limits_with_max_connections(&base, 1);
  if !validate_limits(&l1).is_ok() {
    return false;
  }
  let l4096 = limits_with_max_connections(&base, 4096);
  if !validate_limits(&l4096).is_ok() {
    return false;
  }
  let l4097 = limits_with_max_connections(&base, 4097);
  if validate_limits(&l4097).is_ok() {
    return false;
  }
  let l65537 = limits_with_max_connections(&base, 65537);
  if validate_limits(&l65537).is_ok() {
    return false;
  }
  return true;
}

fn test_handshaking_connections() -> Bool
  intent "ハンドシェイク中同時接続数の境界試験"
  requires none
  ensures none
  effects none
