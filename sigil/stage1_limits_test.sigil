fn test_timeouts() -> Bool
  intent "各種タイムアウト設定の境界試験"
  requires none
  ensures none
  effects none
{
  let base = default_limits();

  // handshake_timeout_secs: 1..=60
  let h0 = limits_with_handshake_timeout_secs(&base, 0);
  if validate_limits(&h0).is_ok() {
    return false;
  }
  let h1 = limits_with_handshake_timeout_secs(&base, 1);
  if !validate_limits(&h1).is_ok() {
    return false;
  }
  let h60 = limits_with_handshake_timeout_secs(&base, 60);
  if !validate_limits(&h60).is_ok() {
    return false;
  }
  let h61 = limits_with_handshake_timeout_secs(&base, 61);
  if validate_limits(&h61).is_ok() {
    return false;
  }

  // idle_timeout_secs: 5..=3600
  let i4 = limits_with_idle_timeout_secs(&base, 4);
  if validate_limits(&i4).is_ok() {
    return false;
  }
  let i5 = limits_with_idle_timeout_secs(&base, 5);
  if !validate_limits(&i5).is_ok() {
    return false;
  }
  let i3600 = limits_with_idle_timeout_secs(&base, 3600);
  if !validate_limits(&i3600).is_ok() {
    return false;
  }
  let i3601 = limits_with_idle_timeout_secs(&base, 3601);
  if validate_limits(&i3601).is_ok() {
    return false;
  }

  // write_timeout_secs: 1..=300
  let w0 = limits_with_write_timeout_secs(&base, 0);
  if validate_limits(&w0).is_ok() {
    return false;
  }
  let w1 = limits_with_write_timeout_secs(&base, 1);
  if !validate_limits(&w1).is_ok() {
    return false;
  }
  let w300 = limits_with_write_timeout_secs(&base, 300);
  if !validate_limits(&w300).is_ok() {
    return false;
  }
  let w301 = limits_with_write_timeout_secs(&base, 301);
  if validate_limits(&w301).is_ok() {
    return false;
  }

  // upstream_connect_timeout_secs: 1..=30
  let u0 = limits_with_upstream_connect_timeout_secs(&base, 0);
  if validate_limits(&u0).is_ok() {
    return false;
  }
  let u1 = limits_with_upstream_connect_timeout_secs(&base, 1);
  if !validate_limits(&u1).is_ok() {
    return false;
  }
  let u30 = limits_with_upstream_connect_timeout_secs(&base, 30);
  if !validate_limits(&u30).is_ok() {
    return false;
  }
  let u31 = limits_with_upstream_connect_timeout_secs(&base, 31);
  if validate_limits(&u31).is_ok() {
    return false;
  }

  return true;
}

pub fn main() -> Int
  intent "上限境界試験のエントリポイント"
  requires none
  ensures none
  effects none
{
  if !test_default() {
    return 1;
  }
  if !test_connections() {
    return 2;
  }
  if !test_handshaking_connections() {
    return 3;
  }
  if !test_connections_per_source() {
    return 4;
  }
  if !test_handshaking_per_source() {
    return 5;
  }
  if !test_crypto_tasks() {
    return 6;
  }
  if !test_timeouts() {
    return 7;
  }
  return 0;
}
