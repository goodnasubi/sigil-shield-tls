module shield_key_schedule
  targets server
  trust none

use shield_cipher_suite.CipherSuite;
use shield_cipher_suite.cipher_suite_hash_len;
use shield_cipher_suite.cipher_suite_iv_len;
use shield_cipher_suite.cipher_suite_key_len;

// TLS 1.3 鍵スケジュール（ADR 0063 決定 1, RFC 8446 §7.1）
//
// - ハンドシェイク秘密からアプリケーション秘密までの導出
// - 方向別の key と iv の導出 (HKDF-Expand-Label)
// - 鍵更新時の次世代 Traffic Secret 導出 ("traffic upd")

pub fn build_hkdf_label(length: Int, label: String, context: &Bytes) -> Bytes
  intent "HKDF-Expand-Label 用の HkdfLabel バイト列を構築する"
  requires none
  ensures none
  effects none
{
  let prefix = "tls13 ".as_bytes();
  let label_bytes = label.as_bytes();
  let full_label_len = prefix.byte_len() + label_bytes.byte_len();

  let mut out = Bytes.with_capacity(2 + 1 + full_label_len + 1 + context.byte_len());
  out.push(length / 256);
  out.push(length % 256);
  out.push(full_label_len);
  out.extend(&prefix);
  out.extend(&label_bytes);
  out.push(context.byte_len());
  out.extend(&context);
  return out;
}

pub fn hmac_sha384_raw(key: &Bytes, message: &Bytes) -> Bytes
  intent "任意長の鍵で HMAC-SHA-384 を計算する（RFC 2104 / RFC 4231）"
  requires none
  ensures result.byte_len() == 48
  effects none
{
  let mut kb = key.clone();
  if kb.byte_len() > 128 {
    let hashed = sha384(&kb);
    kb = hashed;
  }
  while kb.byte_len() < 128 {
    kb.push(0);
  }
  let mut ipad = Bytes.new();
  let mut opad = Bytes.new();
  let mut i = 0;
  while i < 128 {
    let b = kb.get(i).unwrap_or(0);
    ipad.push(b ^ 54);
    opad.push(b ^ 92);
    i = i + 1;
  }
  let mut inner = ipad;
  inner.extend(&message);
  let inner_hash = sha384(&inner);
  let mut outer = opad;
  outer.extend(&inner_hash);
  return sha384(&outer);
}

pub fn hkdf_extract_suite(suite: &CipherSuite, salt: &Bytes, ikm: &Bytes) -> Secret
  intent "暗号スイートに応じた HKDF-Extract を実行する"
  requires none
  ensures none
  effects none
{
  let hlen = cipher_suite_hash_len(&suite);
  let mut effective_salt = salt.clone();
  if effective_salt.is_empty() {
    let mut z = 0;
    while z < hlen {
      effective_salt.push(0);
      z = z + 1;
    }
  }

  match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => {
      let salt_secret = Secret.from_bytes(effective_salt);
      return hmac_sha256(&salt_secret, &ikm);
    }
    CipherSuite.TlsAes128GcmSha256 => {
      let salt_secret = Secret.from_bytes(effective_salt);
      return hmac_sha256(&salt_secret, &ikm);
    }
    CipherSuite.TlsAes256GcmSha384 => {
      let prk_bytes = hmac_sha384_raw(&effective_salt, &ikm);
      return Secret.from_bytes(prk_bytes);
    }
  }
}

pub fn hkdf_expand_suite(suite: &CipherSuite, secret: &Secret, info: &Bytes, out_len: Int) -> Secret
  intent "暗号スイートに応じた HKDF-Expand を実行する"
  requires none
  ensures none
  effects none
{
  let hlen = cipher_suite_hash_len(&suite);
  let blocks = (out_len + hlen - 1) / hlen;
  let mut okm = Bytes.new();
  let mut t = Bytes.new();
  let mut n = 1;

  while n <= blocks {
    let mut msg = t.clone();
    msg.extend(&info);
    msg.push(n);

    let mut next_t_bytes = Bytes.new();
    match suite {
      CipherSuite.TlsChacha20Poly1305Sha256 => {
        let sec_res = hmac_sha256(&secret, &msg);
        next_t_bytes = sec_res.expose();
      }
      CipherSuite.TlsAes128GcmSha256 => {
        let sec_res = hmac_sha256(&secret, &msg);
        next_t_bytes = sec_res.expose();
      }
      CipherSuite.TlsAes256GcmSha384 => {
        let raw_key = secret.expose();
        next_t_bytes = hmac_sha384_raw(&raw_key, &msg);
      }
    }

    t = next_t_bytes;
    okm.extend(&t);
    n = n + 1;
  }

  let out = okm.slice(0, out_len).unwrap_or(Bytes.new());
  return Secret.from_bytes(out);
}

pub fn hkdf_expand_label(suite: &CipherSuite, secret: &Secret, label: String, context: &Bytes, out_len: Int) -> Secret
  intent "HKDF-Expand-Label を実行する (RFC 8446 §7.1)"
  requires none
  ensures none
  effects none
{
  let hkdf_label = build_hkdf_label(out_len, label, &context);
  return hkdf_expand_suite(&suite, &secret, &hkdf_label, out_len);
}

pub fn empty_hash(suite: &CipherSuite) -> Bytes
  intent "空文字列に対するトランスクリプトハッシュ Transcript-Hash(\"\") を返す"
  requires none
  ensures none
  effects none
{
  let empty = Bytes.new();
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => sha256(&empty),
    CipherSuite.TlsAes128GcmSha256 => sha256(&empty),
    CipherSuite.TlsAes256GcmSha384 => sha384(&empty),
  };
}

pub fn derive_secret(suite: &CipherSuite, secret: &Secret, label: String, transcript_hash: &Bytes) -> Secret
  intent "Derive-Secret(Secret, Label, Messages) を計算する"
  requires none
  ensures none
  effects none
{
  let hlen = cipher_suite_hash_len(&suite);
  return hkdf_expand_label(&suite, &secret, label, &transcript_hash, hlen);
}

pub fn early_secret(suite: &CipherSuite) -> Secret
  intent "Early Secret を導出する (PSK なし: salt=0, IKM=0)"
  requires none
  ensures none
  effects none
{
  let hlen = cipher_suite_hash_len(&suite);
  let mut zeros = Bytes.with_capacity(hlen);
  let mut i = 0;
  while i < hlen {
    zeros.push(0);
    i = i + 1;
  }
  return hkdf_extract_suite(&suite, &zeros, &zeros);
}

pub fn handshake_secret(suite: &CipherSuite, early: &Secret, shared_secret: &Bytes) -> Secret
  intent "Handshake Secret を導出する"
  requires none
  ensures none
  effects none
{
  let empty_h = empty_hash(&suite);
  let derived = derive_secret(&suite, &early, "derived", &empty_h);
  let derived_bytes = derived.expose();
  return hkdf_extract_suite(&suite, &derived_bytes, &shared_secret);
}

pub fn master_secret(suite: &CipherSuite, hs_secret: &Secret) -> Secret
  intent "Master Secret を導出する"
  requires none
  ensures none
  effects none
{
  let empty_h = empty_hash(&suite);
  let derived = derive_secret(&suite, &hs_secret, "derived", &empty_h);
  let derived_bytes = derived.expose();
  let hlen = cipher_suite_hash_len(&suite);
  let mut zeros = Bytes.with_capacity(hlen);
  let mut i = 0;
  while i < hlen {
    zeros.push(0);
    i = i + 1;
  }
  return hkdf_extract_suite(&suite, &derived_bytes, &zeros);
}

pub fn client_handshake_traffic_secret(suite: &CipherSuite, hs_secret: &Secret, transcript_hash: &Bytes) -> Secret
  intent "クライアントハンドシェイクトラフィック秘密 (c hs traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &hs_secret, "c hs traffic", &transcript_hash);
}

pub fn server_handshake_traffic_secret(suite: &CipherSuite, hs_secret: &Secret, transcript_hash: &Bytes) -> Secret
  intent "サーバーハンドシェイクトラフィック秘密 (s hs traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &hs_secret, "s hs traffic", &transcript_hash);
}

pub fn client_application_traffic_secret_0(suite: &CipherSuite, m_secret: &Secret, transcript_hash: &Bytes) -> Secret
  intent "クライアントアプリケーショントラフィック秘密 0 (c ap traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &m_secret, "c ap traffic", &transcript_hash);
}

pub fn server_application_traffic_secret_0(suite: &CipherSuite, m_secret: &Secret, transcript_hash: &Bytes) -> Secret
  intent "サーバーアプリケーショントラフィック秘密 0 (s ap traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &m_secret, "s ap traffic", &transcript_hash);
}

pub fn derive_traffic_key(suite: &CipherSuite, traffic_secret: &Secret) -> Secret
  intent "トラフィック鍵を導出する"
  requires none
  ensures none
  effects none
{
  let klen = cipher_suite_key_len(&suite);
  let empty = Bytes.new();
  return hkdf_expand_label(&suite, &traffic_secret, "key", &empty, klen);
}

pub fn derive_traffic_iv(suite: &CipherSuite, traffic_secret: &Secret) -> Bytes
  intent "トラフィック IV を導出する（12 バイト）"
  requires none
  ensures none
  effects none
{
  let iv_len = cipher_suite_iv_len(&suite);
  let empty = Bytes.new();
  let iv_sec = hkdf_expand_label(&suite, &traffic_secret, "iv", &empty, iv_len);
  return iv_sec.expose();
}

pub fn next_traffic_secret(suite: &CipherSuite, current_secret: &Secret) -> Secret
  intent "鍵更新時の次世代 Traffic Secret (\"traffic upd\") を導出する"
  requires none
  ensures none
  effects none
{
  let hlen = cipher_suite_hash_len(&suite);
  let empty = Bytes.new();
  return hkdf_expand_label(&suite, &current_secret, "traffic upd", &empty, hlen);
}
