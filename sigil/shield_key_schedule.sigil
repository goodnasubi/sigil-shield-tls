module shield_key_schedule
  targets server
  trust none

use shield_cipher_suite.CipherSuite;
use shield_cipher_suite.cipher_suite_hash_len;
use shield_cipher_suite.cipher_suite_key_len;

// TLS 1.3 鍵スケジュール（ADR 0063 決定 1, RFC 8446 §7.1）
//
// - ハンドシェイク秘密からアプリケーション秘密までの導出
// - 方向別の key と iv の導出（HKDF-Expand-Label）
// - 鍵更新時の次世代 Traffic Secret 導出 ("traffic upd")

pub fn empty_transcript_hash(suite: &CipherSuite) -> Bytes
  intent "空文字列に対するトランスクリプトハッシュ Transcript-Hash(\"\") を計算する"
  requires none
  ensures none
  effects none
{
  let empty = Bytes.new();
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => sha256(&empty),
    CipherSuite.TlsAes128GcmSha256 => sha256(&empty),
    CipherSuite.TlsAes256GcmSha384 => sha384(&empty),
  };
}

fn hmac_sha256_raw(key: &Bytes, message: &Bytes) -> Bytes
  intent "任意長鍵で HMAC-SHA-256 を計算する (RFC 2104)"
  requires none
  ensures none
  effects none
{
  let mut kb = key.clone();
  if kb.byte_len() > 64 {
    kb = sha256(&kb);
  }
  while kb.byte_len() < 64 {
    kb.push(0);
  }
  let mut ipad = Bytes.with_capacity(64 + message.byte_len());
  let mut opad = Bytes.with_capacity(64 + 32);
  let mut i = 0;
  while i < 64 {
    let b = kb.get(i).unwrap_or(0);
    ipad.push(b ^ 54);
    opad.push(b ^ 92);
    i = i + 1;
  }
  ipad.extend(&message);
  let inner_hash = sha256(&ipad);
  opad.extend(&inner_hash);
  return sha256(&opad);
}

fn hmac_sha384_raw(key: &Bytes, message: &Bytes) -> Bytes
  intent "任意長鍵で HMAC-SHA-384 を計算する (RFC 2104 / RFC 4231)"
  requires none
  ensures none
  effects none
{
  let mut kb = key.clone();
  if kb.byte_len() > 128 {
    kb = sha384(&kb);
  }
  while kb.byte_len() < 128 {
    kb.push(0);
  }
  let mut ipad = Bytes.with_capacity(128 + message.byte_len());
  let mut opad = Bytes.with_capacity(128 + 48);
  let mut i = 0;
  while i < 128 {
    let b = kb.get(i).unwrap_or(0);
    ipad.push(b ^ 54);
    opad.push(b ^ 92);
    i = i + 1;
  }
  ipad.extend(&message);
  let inner_hash = sha384(&ipad);
  opad.extend(&inner_hash);
  return sha384(&opad);
}

pub fn hkdf_extract(suite: &CipherSuite, salt: &Bytes, ikm: &Bytes) -> Bytes
  intent "HKDF-Extract を実行し PRK バイト列を返す (RFC 5869 §2.2)"
  requires none
  ensures none
  effects none
{
  let hash_len = cipher_suite_hash_len(&suite);
  let mut actual_salt = salt.clone();
  if actual_salt.byte_len() == 0 {
    let mut i = 0;
    while i < hash_len {
      actual_salt.push(0);
      i = i + 1;
    }
  }

  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => hmac_sha256_raw(&actual_salt, &ikm),
    CipherSuite.TlsAes128GcmSha256 => hmac_sha256_raw(&actual_salt, &ikm),
    CipherSuite.TlsAes256GcmSha384 => hmac_sha384_raw(&actual_salt, &ikm),
  };
}

pub fn build_hkdf_label(length: Int, label: String, context: &Bytes) -> Bytes
  intent "HkdfLabel 構造体のバイト列を構築する (RFC 8446 §7.1)"
  requires none
  ensures none
  effects none
{
  let prefix = "tls13 ".as_bytes();
  let label_bytes = label.as_bytes();
  let full_label_len = prefix.byte_len() + label_bytes.byte_len();

  let mut out = Bytes.with_capacity(2 + 1 + full_label_len + 1 + context.byte_len());
  out.push(length / 256);
  out.push(length % 256);
  out.push(full_label_len);
  out.extend(&prefix);
  out.extend(&label_bytes);
  out.push(context.byte_len());
  out.extend(&context);
  return out;
}

pub fn hkdf_expand_label(suite: &CipherSuite, secret: &Bytes, label: String, context: &Bytes, out_len: Int) -> Bytes
  intent "HKDF-Expand-Label を実行する (RFC 8446 §7.1)"
  requires none
  ensures none
  effects none
{
  let info = build_hkdf_label(out_len, label, &context);
  let hash_len = cipher_suite_hash_len(&suite);
  let blocks = (out_len + hash_len - 1) / hash_len;

  let mut okm = Bytes.new();
  let mut t = Bytes.new();
  let mut n = 1;
  while n <= blocks {
    let mut msg = t.clone();
    msg.extend(&info);
    msg.push(n);

    match suite {
      CipherSuite.TlsChacha20Poly1305Sha256 => {
        t = hmac_sha256_raw(&secret, &msg);
      }
      CipherSuite.TlsAes128GcmSha256 => {
        t = hmac_sha256_raw(&secret, &msg);
      }
      CipherSuite.TlsAes256GcmSha384 => {
        t = hmac_sha384_raw(&secret, &msg);
      }
    }
    okm.extend(&t);
    n = n + 1;
  }
  return okm.slice(0, out_len).unwrap_or(Bytes.new());
}

pub fn derive_secret(suite: &CipherSuite, secret: &Bytes, label: String, transcript_hash: &Bytes) -> Bytes
  intent "Derive-Secret(Secret, Label, Messages) を計算する"
  requires none
  ensures none
  effects none
{
  let hash_len = cipher_suite_hash_len(&suite);
  return hkdf_expand_label(&suite, &secret, label, &transcript_hash, hash_len);
}

pub fn early_secret(suite: &CipherSuite) -> Bytes
  intent "Early Secret を導出する（PSK なし: salt=0, IKM=0）"
  requires none
  ensures none
  effects none
{
  let hash_len = cipher_suite_hash_len(&suite);
  let mut zeros = Bytes.with_capacity(hash_len);
  let mut i = 0;
  while i < hash_len {
    zeros.push(0);
    i = i + 1;
  }
  return hkdf_extract(&suite, &zeros, &zeros);
}

pub fn handshake_secret(suite: &CipherSuite, early_sec: &Bytes, shared_secret: &Bytes) -> Bytes
  intent "Handshake Secret を導出する: Extract(Derive-Secret(Early, derived, empty_hash), shared_secret)"
  requires none
  ensures none
  effects none
{
  let empty_h = empty_transcript_hash(&suite);
  let derived = derive_secret(&suite, &early_sec, "derived", &empty_h);
  return hkdf_extract(&suite, &derived, &shared_secret);
}

pub fn master_secret(suite: &CipherSuite, hs_sec: &Bytes) -> Bytes
  intent "Master Secret を導出する: Extract(Derive-Secret(Handshake, derived, empty_hash), 0)"
  requires none
  ensures none
  effects none
{
  let empty_h = empty_transcript_hash(&suite);
  let derived = derive_secret(&suite, &hs_sec, "derived", &empty_h);
  let hash_len = cipher_suite_hash_len(&suite);
  let mut zeros = Bytes.with_capacity(hash_len);
  let mut i = 0;
  while i < hash_len {
    zeros.push(0);
    i = i + 1;
  }
  return hkdf_extract(&suite, &derived, &zeros);
}

pub fn client_handshake_traffic_secret(suite: &CipherSuite, hs_sec: &Bytes, transcript_hash: &Bytes) -> Bytes
  intent "クライアントハンドシェイクトラフィック秘密 (c hs traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &hs_sec, "c hs traffic", &transcript_hash);
}

pub fn server_handshake_traffic_secret(suite: &CipherSuite, hs_sec: &Bytes, transcript_hash: &Bytes) -> Bytes
  intent "サーバーハンドシェイクトラフィック秘密 (s hs traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &hs_sec, "s hs traffic", &transcript_hash);
}

pub fn client_application_traffic_secret_0(suite: &CipherSuite, master_sec: &Bytes, transcript_hash: &Bytes) -> Bytes
  intent "クライアントアプリケーショントラフィック秘密 0 (c ap traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &master_sec, "c ap traffic", &transcript_hash);
}

pub fn server_application_traffic_secret_0(suite: &CipherSuite, master_sec: &Bytes, transcript_hash: &Bytes) -> Bytes
  intent "サーバーアプリケーショントラフィック秘密 0 (s ap traffic) を導出する"
  requires none
  ensures none
  effects none
{
  return derive_secret(&suite, &master_sec, "s ap traffic", &transcript_hash);
}

pub fn derive_traffic_key(suite: &CipherSuite, traffic_secret: &Bytes) -> Bytes
  intent "トラフィック鍵を導出する: HKDF-Expand-Label(Secret, key, \"\", key_len)"
  requires none
  ensures none
  effects none
{
  let empty = Bytes.new();
  return hkdf_expand_label(&suite, &traffic_secret, "key", &empty, cipher_suite_key_len(&suite));
}

pub fn derive_traffic_iv(suite: &CipherSuite, traffic_secret: &Bytes) -> Bytes
  intent "トラフィック IV を導出する: HKDF-Expand-Label(Secret, iv, \"\", 12)"
  requires none
  ensures none
  effects none
{
  let empty = Bytes.new();
  return hkdf_expand_label(&suite, &traffic_secret, "iv", &empty, 12);
}

pub fn next_traffic_secret(suite: &CipherSuite, current_secret: &Bytes) -> Bytes
  intent "鍵更新時の次世代 Traffic Secret を導出する: HKDF-Expand-Label(current, traffic upd, \"\", hash_len)"
  requires none
  ensures none
  effects none
{
  let empty = Bytes.new();
  return hkdf_expand_label(&suite, &current_secret, "traffic upd", &empty, cipher_suite_hash_len(&suite));
}
