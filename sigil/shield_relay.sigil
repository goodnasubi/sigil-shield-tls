module shield_relay
  targets server
  trust none

use shield_alert.AlertDescription;
use shield_alert.ShieldError;
use shield_alert.alert_description_to_u8;
use shield_limits.ShieldLimits;
use shield_record.ContentType;
use shield_record_crypto.RecordProtection;
use shield_record_crypto.seal_record;

// 中継部品（ADR 0063 決定 3, 決定 4.4, 4.5, 決定 5.1, 5.3）
//
// 1. 待ち受け: 待ち受けアドレスは設定で必須とし、既定値を置かない。
// 2. 上流（決定 3）:
//    - 設定で数値の IP アドレスとポートを 1 つ指定する（DNS は使わない）。
//    - 1 つの待ち受けに上流は 1 つ。名前による後段の振り分けは終端部品では行わない。
//    - 既定でループバック（127.0.0.1・::1）だけを許す。
//    - 非ループバックは allow_non_loopback_upstream = true の明示がある場合だけ許し、違反は起動拒否。
// 3. 接続ごとのタスク:
//    - 1 つの TLS 接続に対して新しい上流接続を 1 つ開き、接続を共有・再利用しない。
// 4. 上限（決定 4.5）:
//    - 同時接続数（既定 1024、範囲 1〜65536）
//    - ハンドシェイク中同時接続数（既定 64、範囲 1〜1024）
//    - 接続元ごとの同時接続数（既定 32、範囲 1〜1024）
//    - 接続元ごとのハンドシェイク中接続数（既定 4、範囲 1〜64）
//    - 鍵交換と署名を同時に計算する数（既定 2、範囲 1〜64、超過時は順番を待つ）
// 5. タイムアウトとバッファ（決定 4.4）:
//    - ハンドシェイク全体 10 秒、アイドル期限 60 秒、書き込み期限 30 秒、上流接続 3 秒。
//    - 各方向のバッファは 2 レコード分、32 KiB 以下で、満ちたら読み取りを止め期限まで待つ。
// 6. 上流への接続と PROXY v2（決定 5.1, 5.3）:
//    - 上流接続はハンドシェイク完了後に開く。完了前に届いた平文は 32 KiB までバッファ。
//    - 先頭に PROXY v2 ヘッダーを 1 回だけ付与（HTTP は解釈しない）。
// 7. 終了の扱い（決定 5.3）:
//    - 上流接続失敗/期限超過: 固定 502 Bad Gateway 送信後 close_notify で終了。
//    - 上流異常終了: close_notify なしで致命的アラート internal_error で終了。
//    - 上流正常終了: 送り切ってから close_notify で終了。
//    - クライアント close_notify: 上流 write shutdown、アイドル期限まで待機。
//    - クライアント切断（close_notify なし）: 切り詰めとして扱い上流切断。
// 8. ログ（決定 5.3）:
//    - 接続元・正規化済み SNI（[a-z0-9._*-] に制限・長さ制限）・結果分類のみ。
//    - 秘密（鍵・平文・ClientHello 中身・通信鍵）は一切出さない。

pub enum RelayConfigError {
  EmptyListenHost,
  InvalidPort(Int),
  DnsUpstreamDisallowed(String),
  NonLoopbackUpstreamDisallowed(String),
  InvalidNumericIp(String),
}

pub struct ListenConfig {
  host: String,
  port: Int,
}

pub fn new_listen_config(host: String, port: Int) -> ListenConfig
  intent "待ち受け設定を生成する（既定値なし、必須指定）"
  requires none
  ensures none
  effects none
{
  return ListenConfig { host: host, port: port };
}

pub fn validate_listen_config(cfg: &ListenConfig) -> Result<Bool, RelayConfigError>
  intent "待ち受け設定を検証する（host 必須、ポート 1-65535）"
  requires none
  ensures none
  effects none
{
  if cfg.host.as_bytes().is_empty() {
    return Err(RelayConfigError.EmptyListenHost);
  }
  if cfg.port < 1 || cfg.port > 65535 {
    return Err(RelayConfigError.InvalidPort(cfg.port));
  }
  return Ok(true);
}

pub struct UpstreamConfig {
  host: String,
  port: Int,
  allow_non_loopback: Bool,
}

pub fn new_upstream_config(host: String, port: Int, allow_non_loopback: Bool) -> UpstreamConfig
  intent "上流設定を生成する"
  requires none
  ensures none
  effects none
{
  return UpstreamConfig { host: host, port: port, allow_non_loopback: allow_non_loopback };
}

fn is_ascii_digit(c: Int) -> Bool
  intent "文字コードが 0-9 か判定する"
  requires none
  ensures none
  effects none
{
  return c >= 48 && c <= 57;
}

fn is_hex_digit(c: Int) -> Bool
  intent "文字コードが 16 進数 (0-9, a-f, A-F) か判定する"
  requires none
  ensures none
  effects none
{
  if c >= 48 && c <= 57 {
    return true;
  }
  if c >= 97 && c <= 102 {
    return true;
  }
  if c >= 65 && c <= 70 {
    return true;
  }
  return false;
}

pub fn is_ipv4_numeric(host: &String) -> Bool
  intent "文字列が数値 IPv4 アドレス (x.x.x.x, 0-255) か厳密に判定する"
  requires none
  ensures none
  effects none
{
  let b = host.as_bytes();
  let blen = b.byte_len();
  if blen < 7 || blen > 15 {
    return false;
  }

  let mut dots = 0;
  let mut current_val = 0;
  let mut segment_len = 0;
  let mut i = 0;

  while i < blen {
    let c = b.get(i).unwrap_or(0);
    if c == 46 {  // '.'
      if segment_len == 0 || segment_len > 3 {
        return false;
      }
      if current_val > 255 {
        return false;
      }
      dots = dots + 1;
      current_val = 0;
      segment_len = 0;
    } else if is_ascii_digit(c) {
      current_val = current_val * 10 + (c - 48);
      segment_len = segment_len + 1;
      if segment_len > 3 || current_val > 255 {
        return false;
      }
    } else {
      return false;
    }
    i = i + 1;
  }

  if dots != 3 || segment_len == 0 || segment_len > 3 || current_val > 255 {
    return false;
  }
  return true;
}

pub fn is_ipv6_numeric(host: &String) -> Bool
  intent "文字列が数値 IPv6 アドレス（16 進数とコロンのみ）か判定する"
  requires none
  ensures none
  effects none
{
  let b = host.as_bytes();
  let blen = b.byte_len();
  if blen < 2 || blen > 39 {
    return false;
  }

  let mut colons = 0;
  let mut i = 0;
  while i < blen {
    let c = b.get(i).unwrap_or(0);
    if c == 58 {  // ':'
      colons = colons + 1;
    } else if is_hex_digit(c) {
      // 16 進文字
    } else {
      // コロンでも 16 進数でもない文字（DNS ドメイン名等）
      return false;
    }
    i = i + 1;
  }

  // IPv6 は少なくとも 1 つ以上のコロンを含む
  return colons >= 1 && colons <= 7;
}

pub fn is_loopback_address(host: &String) -> Bool
  intent "アドレスがループバック（127.0.0.0/8 または ::1 等）か判定する（決定 3）"
  requires none
  ensures none
  effects none
{
  let b = host.as_bytes();
  let blen = b.byte_len();

  // IPv4 ループバック: 127.x.x.x
  if is_ipv4_numeric(&host) {
    if blen >= 4 {
      let c0 = b.get(0).unwrap_or(0);
      let c1 = b.get(1).unwrap_or(0);
      let c2 = b.get(2).unwrap_or(0);
      let c3 = b.get(3).unwrap_or(0);
      if c0 == 49 && c1 == 50 && c2 == 55 && c3 == 46 {  // "127."
        return true;
      }
    }
    return false;
  }

  // IPv6 ループバック: "::1"
  if blen == 3 {
    let c0 = b.get(0).unwrap_or(0);
    let c1 = b.get(1).unwrap_or(0);
    let c2 = b.get(2).unwrap_or(0);
    if c0 == 58 && c1 == 58 && c2 == 49 {  // "::1"
      return true;
    }
  }

  // IPv6 完全表記: 0000:0000:0000:0000:0000:0000:0000:0001 または 0:0:0:0:0:0:0:1
  if blen == 15 {
    // "0:0:0:0:0:0:0:1"
    let c_last = b.get(14).unwrap_or(0);
    if c_last == 49 {
      return true;
    }
  }

  return false;
}

pub fn validate_upstream_config(cfg: &UpstreamConfig) -> Result<Bool, RelayConfigError>
  intent "上流設定の数値 IP・ポート・ループバック制約を検証する（決定 3）"
  requires none
  ensures none
  effects none
{
  if cfg.port < 1 || cfg.port > 65535 {
    return Err(RelayConfigError.InvalidPort(cfg.port));
  }

  // 数値 IP アドレス検査（DNS は使わない）
  let is_v4 = is_ipv4_numeric(&cfg.host);
  let is_v6 = is_ipv6_numeric(&cfg.host);
  if !is_v4 && !is_v6 {
    return Err(RelayConfigError.DnsUpstreamDisallowed(cfg.host.clone()));
  }

  // ループバック制約検査（既定でループバックのみ許可、非ループバックは明示的許可が必要）
  let is_loop = is_loopback_address(&cfg.host);
  if !is_loop && !cfg.allow_non_loopback {
    return Err(RelayConfigError.NonLoopbackUpstreamDisallowed(cfg.host.clone()));
  }

  return Ok(true);
}

// 資源上限超過による接続拒否理由（決定 4.5）
pub enum RelayRejectReason {
  MaxConnectionsExceeded(Int, Int),
  MaxHandshakingExceeded(Int, Int),
  SourceMaxConnectionsExceeded(String, Int, Int),
  SourceMaxHandshakingExceeded(String, Int, Int),
}

pub struct SourceEntry {
  source_key: String,
  total_conns: Int,
  handshaking_conns: Int,
}

pub struct RelayTracker {
  active_connections: Int,
  active_handshakes: Int,
  active_crypto_tasks: Int,
  crypto_waiting_count: Int,
  sources: List<SourceEntry>,
}

pub fn new_relay_tracker() -> RelayTracker
  intent "接続数および暗号タスク管理トラッカーを初期化する"
  requires none
  ensures none
  effects none
{
  return RelayTracker { active_connections: 0, active_handshakes: 0, active_crypto_tasks: 0, crypto_waiting_count: 0, sources: List.new() };
}

pub fn tracker_active_connections(t: &RelayTracker) -> Int
  intent "現在の接続数を返す"
  requires none
  ensures none
  effects none
{
  return t.active_connections;
}

pub fn tracker_active_handshakes(t: &RelayTracker) -> Int
  intent "現在のハンドシェイク中接続数を返す"
  requires none
  ensures none
  effects none
{
  return t.active_handshakes;
}

pub fn tracker_active_crypto_tasks(t: &RelayTracker) -> Int
  intent "現在の並行暗号計算タスク数を返す"
  requires none
  ensures none
  effects none
{
  return t.active_crypto_tasks;
}

pub fn tracker_crypto_waiting_count(t: &RelayTracker) -> Int
  intent "現在暗号計算待ちのタスク数を返す"
  requires none
  ensures none
  effects none
{
  return t.crypto_waiting_count;
}

pub fn extract_source_key(peer_addr: &String) -> String
  intent "接続元 IP（IPv4 は /32、IPv6 は /64 相当のプレフィクス）を抽出する（決定 4.5）"
  requires none
  ensures none
  effects none
{
  let b = peer_addr.as_bytes();
  let blen = b.byte_len();

  // IPv6（コロンを含む）の場合: 最初の 4 セグメント（/64）までを取り出す
  let mut dot_count = 0;
  let mut colon_count = 0;
  let mut port_colon = blen;
  let mut cut_idx_v6 = blen;
  let mut i = 0;

  while i < blen {
    let c = b.get(i).unwrap_or(0);
    if c == 46 {  // '.'
      dot_count = dot_count + 1;
    }
    if c == 58 {  // ':'
      colon_count = colon_count + 1;
      port_colon = i;
      if colon_count == 4 {
        cut_idx_v6 = i;
      }
    }
    i = i + 1;
  }

  // IPv4: 3 個のドットがある場合
  if dot_count == 3 {
    let ip_only = b.slice(0, port_colon).unwrap_or(Bytes.new());
    return ip_only.to_string_utf8().unwrap_or(peer_addr.clone());
  }

  // IPv6: 2 個以上のコロンがある場合
  if colon_count >= 2 {
    let prefix = b.slice(0, cut_idx_v6).unwrap_or(Bytes.new());
    return prefix.to_string_utf8().unwrap_or(peer_addr.clone());
  }

  return peer_addr.clone();
}

fn string_eq(a: &String, b: &String) -> Bool
  intent "2 つの文字列がバイト単位で等しいか判定する"
  requires none
  ensures none
  effects none
{
  let ba = a.as_bytes();
  let bb = b.as_bytes();
  if ba.byte_len() != bb.byte_len() {
    return false;
  }
  let mut i = 0;
  while i < ba.byte_len() {
    if ba.get(i).unwrap_or(0) != bb.get(i).unwrap_or(0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn find_source_index(sources: &List<SourceEntry>, key: &String) -> Option<Int>
  intent "接続元キーに対応するリスト内インデックスを検索する"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < sources.len() {
    match sources.get(i) {
      Some(entry) => {
        if string_eq(&entry.source_key, &key) {
          return Some(i);
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return None;
}

pub fn tracker_try_accept(tracker: &mut RelayTracker, limits: &ShieldLimits, peer_addr: &String) -> Result<Bool, RelayRejectReason>
  intent "新規接続の受領可否を上限（決定 4.5）に照らして判定し、許容なら追跡数を更新する"
  requires none
  ensures none
  effects none
{
  // 1. 同時接続数上限
  if tracker.active_connections >= limits.max_connections {
    return Err(RelayRejectReason.MaxConnectionsExceeded(tracker.active_connections, limits.max_connections));
  }

  // 2. ハンドシェイク中同時接続数上限
  if tracker.active_handshakes >= limits.max_handshaking_connections {
    return Err(RelayRejectReason.MaxHandshakingExceeded(tracker.active_handshakes, limits.max_handshaking_connections));
  }

  let src_key = extract_source_key(&peer_addr);
  let src_idx_opt = find_source_index(&tracker.sources, &src_key);

  let cur_src_total = match src_idx_opt {
    Some(idx) => match tracker.sources.get(idx) {
      Some(e) => e.total_conns,
      None => 0,
    },
    None => 0,
  };

  let cur_src_hs = match src_idx_opt {
    Some(idx) => match tracker.sources.get(idx) {
      Some(e) => e.handshaking_conns,
      None => 0,
    },
    None => 0,
  };

  // 3. 接続元ごとの同時接続数上限
  if cur_src_total >= limits.max_connections_per_source {
    return Err(RelayRejectReason.SourceMaxConnectionsExceeded(src_key, cur_src_total, limits.max_connections_per_source));
  }

  // 4. 接続元ごとのハンドシェイク中接続数上限
  if cur_src_hs >= limits.max_handshaking_per_source {
    return Err(RelayRejectReason.SourceMaxHandshakingExceeded(src_key, cur_src_hs, limits.max_handshaking_per_source));
  }

  // 上限内: カウンタ更新
  tracker.active_connections = tracker.active_connections + 1;
  tracker.active_handshakes = tracker.active_handshakes + 1;

  match src_idx_opt {
    Some(idx) => {
      // 既存のエントリを更新
      let mut new_sources = List.new();
      let mut i = 0;
      while i < tracker.sources.len() {
        match tracker.sources.get(i) {
          Some(e) => {
            if i == idx {
              new_sources.push(SourceEntry { source_key: e.source_key.clone(), total_conns: e.total_conns + 1, handshaking_conns: e.handshaking_conns + 1 });
            } else {
              new_sources.push(SourceEntry { source_key: e.source_key.clone(), total_conns: e.total_conns, handshaking_conns: e.handshaking_conns });
            }
          }
          None => {}
        }
        i = i + 1;
      }
      tracker.sources = new_sources;
    }
    None => {
      // 新規エントリを追加
      tracker.sources.push(SourceEntry { source_key: src_key, total_conns: 1, handshaking_conns: 1 });
    }
  }

  return Ok(true);
}

pub fn tracker_handshake_finished(tracker: &mut RelayTracker, peer_addr: &String)
  intent "ハンドシェイク完了時にハンドシェイク中カウンタを減算する"
  requires none
  ensures none
  effects none
{
  if tracker.active_handshakes > 0 {
    tracker.active_handshakes = tracker.active_handshakes - 1;
  }

  let src_key = extract_source_key(&peer_addr);
  let src_idx_opt = find_source_index(&tracker.sources, &src_key);

  match src_idx_opt {
    Some(idx) => {
      let mut new_sources = List.new();
      let mut i = 0;
      while i < tracker.sources.len() {
        match tracker.sources.get(i) {
          Some(e) => {
            if i == idx {
              let new_hs = match e.handshaking_conns > 0 {
                true => e.handshaking_conns - 1,
                false => 0,
              };
              new_sources.push(SourceEntry { source_key: e.source_key.clone(), total_conns: e.total_conns, handshaking_conns: new_hs });
            } else {
              new_sources.push(SourceEntry { source_key: e.source_key.clone(), total_conns: e.total_conns, handshaking_conns: e.handshaking_conns });
            }
          }
          None => {}
        }
        i = i + 1;
      }
      tracker.sources = new_sources;
    }
    None => {}
  }
}

pub fn tracker_connection_closed(tracker: &mut RelayTracker, peer_addr: &String, was_handshaking: Bool)
  intent "接続切断時に総接続数（および必要に応じハンドシェイク中接続数）を減算する"
  requires none
  ensures none
  effects none
{
  if tracker.active_connections > 0 {
    tracker.active_connections = tracker.active_connections - 1;
  }
  if was_handshaking && tracker.active_handshakes > 0 {
    tracker.active_handshakes = tracker.active_handshakes - 1;
  }

  let src_key = extract_source_key(&peer_addr);
  let src_idx_opt = find_source_index(&tracker.sources, &src_key);

  match src_idx_opt {
    Some(idx) => {
      let mut new_sources = List.new();
      let mut i = 0;
      while i < tracker.sources.len() {
        match tracker.sources.get(i) {
          Some(e) => {
            if i == idx {
              let new_total = match e.total_conns > 0 {
                true => e.total_conns - 1,
                false => 0,
              };
              let new_hs = match was_handshaking && e.handshaking_conns > 0 {
                true => e.handshaking_conns - 1,
                false => e.handshaking_conns,
              };
              // 0 になったらエントリを削除してリークを防ぐ
              if new_total > 0 {
                new_sources.push(SourceEntry { source_key: e.source_key.clone(), total_conns: new_total, handshaking_conns: new_hs });
              }
            } else {
              new_sources.push(SourceEntry { source_key: e.source_key.clone(), total_conns: e.total_conns, handshaking_conns: e.handshaking_conns });
            }
          }
          None => {}
        }
        i = i + 1;
      }
      tracker.sources = new_sources;
    }
    None => {}
  }
}

pub fn tracker_try_acquire_crypto(tracker: &mut RelayTracker, limits: &ShieldLimits) -> Bool
  intent "鍵交換・署名並行計算タスクの取得を試みる（既定 2、超過時は待機）"
  requires none
  ensures none
  effects none
{
  if tracker.active_crypto_tasks < limits.max_concurrent_crypto_tasks {
    tracker.active_crypto_tasks = tracker.active_crypto_tasks + 1;
    return true;
  }
  tracker.crypto_waiting_count = tracker.crypto_waiting_count + 1;
  return false;
}

pub fn tracker_release_crypto(tracker: &mut RelayTracker)
  intent "鍵交換・署名並行計算タスクの完了を通知し解放する"
  requires none
  ensures none
  effects none
{
  if tracker.crypto_waiting_count > 0 {
    tracker.crypto_waiting_count = tracker.crypto_waiting_count - 1;
  } else if tracker.active_crypto_tasks > 0 {
    tracker.active_crypto_tasks = tracker.active_crypto_tasks - 1;
  }
}

// タイムアウトおよびバッファ定数（ADR 0063 決定 4.4, 5.3）
pub fn max_relay_buffer_size() -> Int
  intent "中継バッファの各方向上限（32 KiB = 2 レコード分）"
  requires none
  ensures none
  effects none
{
  return 32768;
}

pub fn max_pre_handshake_plaintext_buffer() -> Int
  intent "ハンドシェイク完了前に届いた平文のバッファ上限（32 KiB）"
  requires none
  ensures none
  effects none
{
  return 32768;
}

pub fn build_502_bad_gateway_response() -> Bytes
  intent "上流接続不能・期限超過時に返す外部入力を含まない固定の 502 Bad Gateway 応答（決定 5.3）"
  requires none
  ensures none
  effects none
{
  let text = "HTTP/1.1 502 Bad Gateway\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 17\r\n\r\n502 Bad Gateway\r\n";
  return text.as_bytes();
}

pub fn build_close_notify_record(prot: &mut RecordProtection) -> Result<Bytes, ShieldError>
  intent "暗号化 close_notify アラートレコードを構築する（決定 5.3）"
  requires none
  ensures none
  effects none
{
  let mut alert_payload = Bytes.with_capacity(2);
  alert_payload.push(1);  // warning
  alert_payload.push(0);  // close_notify
  return seal_record(&mut prot, &ContentType.Alert, &alert_payload, 0);
}

pub fn build_fatal_alert_record(desc: &AlertDescription) -> Bytes
  intent "平文の致命的アラートレコード（TLS レコードヘッダ含む）を構築する"
  requires none
  ensures none
  effects none
{
  let mut rec = Bytes.with_capacity(7);
  rec.push(21);  // ContentType.Alert
  rec.push(3);  // legacy_version 0x0303
  rec.push(3);
  rec.push(0);  // length 2
  rec.push(2);
  rec.push(2);  // fatal
  let code = alert_description_to_u8(&desc);
  rec.push(code);
  return rec;
}

// 中継終了理由の分類（ADR 0063 決定 5.3）
pub enum RelayOutcome {
  NormalCompletion,  // 上流正常終了 -> 残り送信後 close_notify 送信
  UpstreamConnectFailed502,  // 上流接続不能/期限超過 -> 502 Bad Gateway 暗号化送信後 close_notify 送信
  UpstreamAbnormalInternalError,  // 上流異常終了（リセット/期限） -> close_notify なしで致命的 internal_error
  ClientRequestedCloseNotify,  // クライアントが close_notify 送信 -> 上流 write shutdown、応答終わり待機
  ClientTruncatedAbruptClose,  // クライアントが close_notify なしで切断 -> 切り詰めとして上流即時切断
  BufferOverflowExceeded,  // バッファ 32 KiB 超過 -> 致命的切断
}

// ログ出力結果の分類（決定 5.3）
pub enum RelayResultClassification {
  HandshakeSuccess,
  BadGateway502,
  UpstreamInternalError,
  ClientNormalClosed,
  ClientTruncated,
  LimitExceeded,
  TimeoutExpired,
}

pub fn sanitize_sni_for_log(sni: &String) -> String
  intent "ログへの注入を防ぐため、SNI 文字列を [a-z0-9._*-] のみに制限し長さを 253 文字以下に切る（決定 5.3）"
  requires none
  ensures none
  effects none
{
  let b = sni.as_bytes();
  let blen = b.byte_len();
  let max_len = match blen > 253 {
    true => 253,
    false => blen,
  };

  let mut out = Bytes.with_capacity(max_len);
  let mut i = 0;
  while i < max_len {
    let c = b.get(i).unwrap_or(0);
    // [a-z]
    let is_az = c >= 97 && c <= 122;
    // [0-9]
    let is_digit = c >= 48 && c <= 57;
    // '.', '_', '*', '-'
    let is_special = c == 46 || c == 95 || c == 42 || c == 45;

    if is_az || is_digit || is_special {
      out.push(c);
    }
    // 改行（\r, \n）、制御文字、エスケープシーケンス等はすべて除外
    i = i + 1;
  }

  return out.to_string_utf8().unwrap_or("");
}

pub fn format_relay_log(peer_addr: &String, sanitized_sni: &Option<String>, classification: &RelayResultClassification) -> String
  intent "機密（鍵・平文・ClientHello 中身・通信鍵）を一切含まない安全なログ行を整形する（決定 5.3）"
  requires none
  ensures none
  effects none
{
  let mut log = Bytes.new();
  log.extend(&"peer=".as_bytes());
  log.extend(&peer_addr.as_bytes());
  log.extend(&" sni=".as_bytes());
  match sanitized_sni {
    Some(s) => {
      log.extend(&s.as_bytes());
    }
    None => {
      log.extend(&"-".as_bytes());
    }
  }
  log.extend(&" result=".as_bytes());
  let res_str = match classification {
    RelayResultClassification.HandshakeSuccess => "HANDSHAKE_SUCCESS",
    RelayResultClassification.BadGateway502 => "BAD_GATEWAY_502",
    RelayResultClassification.UpstreamInternalError => "UPSTREAM_INTERNAL_ERROR",
    RelayResultClassification.ClientNormalClosed => "CLIENT_CLOSED_NORMAL",
    RelayResultClassification.ClientTruncated => "CLIENT_TRUNCATED",
    RelayResultClassification.LimitExceeded => "LIMIT_EXCEEDED",
    RelayResultClassification.TimeoutExpired => "TIMEOUT_EXPIRED",
  };
  log.extend(&res_str.as_bytes());
  return log.to_string_utf8().unwrap_or("");
}
