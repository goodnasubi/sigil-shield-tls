module shield_alert
  targets server
  trust none

// TLS アラート（ADR 0063 決定 4.1、RFC 8446 §6）
// 解釈の誤りは致命的アラートと接続の終了にする。続行（fail-open）や後段への転送はしない。

pub enum AlertLevel {
  Warning,
  Fatal,
}

pub enum AlertDescription {
  CloseNotify,
  UnexpectedMessage,
  BadRecordMac,
  HandshakeFailure,
  IllegalParameter,
  DecodeError,
  ProtocolVersion,
  InternalError,
  UnrecognizedName,
  NoApplicationProtocol,
}

pub struct Alert {
  level: AlertLevel,
  description: AlertDescription,
}

pub enum ShieldError {
  Fatal(AlertDescription),
  Incomplete(Int),
  TimeoutOrNoProgress,
  ConnectionClosed,
}

pub fn alert_level_to_u8(level: &AlertLevel) -> Int
  intent "アラート深刻度をバイト値に変換する"
  requires none
  ensures none
  effects none
{
  return match level {
    AlertLevel.Warning => 1,
    AlertLevel.Fatal => 2,
  };
}

pub fn alert_description_to_u8(desc: &AlertDescription) -> Int
  intent "アラート記述子をバイト値に変換する"
  requires none
  ensures none
  effects none
{
  return match desc {
    AlertDescription.CloseNotify => 0,
    AlertDescription.UnexpectedMessage => 10,
    AlertDescription.BadRecordMac => 20,
    AlertDescription.HandshakeFailure => 40,
    AlertDescription.IllegalParameter => 47,
    AlertDescription.DecodeError => 50,
    AlertDescription.ProtocolVersion => 70,
    AlertDescription.InternalError => 80,
    AlertDescription.UnrecognizedName => 112,
    AlertDescription.NoApplicationProtocol => 120,
  };
}

pub fn alert_description_from_u8(value: Int) -> Option<AlertDescription>
  intent "バイト値からアラート記述子を取得する"
  requires none
  ensures none
  effects none
{
  if value == 0 {
    return Some(AlertDescription.CloseNotify);
  }
  if value == 10 {
    return Some(AlertDescription.UnexpectedMessage);
  }
  if value == 20 {
    return Some(AlertDescription.BadRecordMac);
  }
  if value == 40 {
    return Some(AlertDescription.HandshakeFailure);
  }
  if value == 47 {
    return Some(AlertDescription.IllegalParameter);
  }
  if value == 50 {
    return Some(AlertDescription.DecodeError);
  }
  if value == 70 {
    return Some(AlertDescription.ProtocolVersion);
  }
  if value == 80 {
    return Some(AlertDescription.InternalError);
  }
  if value == 112 {
    return Some(AlertDescription.UnrecognizedName);
  }
  if value == 120 {
    return Some(AlertDescription.NoApplicationProtocol);
  }
  return None;
}

pub fn fatal_alert(desc: AlertDescription) -> Alert
  intent "致命的アラートを作成する"
  requires none
  ensures none
  effects none
{
  return Alert { level: AlertLevel.Fatal, description: desc };
}

pub fn alert_to_record_bytes(alert: &Alert) -> Bytes
  intent "アラートを TLS レコード層のバイト列（7 バイト）にエンコードする"
  requires none
  ensures result.byte_len() == 7
  effects none
{
  let mut out = Bytes.with_capacity(7);
  out.push(21);
  out.push(3);
  out.push(3);
  out.push(0);
  out.push(2);
  out.push(alert_level_to_u8(&alert.level));
  out.push(alert_description_to_u8(&alert.description));
  return out;
}

pub fn alert_fatal_record_bytes(desc: AlertDescription) -> Bytes
  intent "指定の記述子を持つ致命的アラートを 7 バイトのレコード層表現にエンコードする"
  requires none
  ensures result.byte_len() == 7
  effects none
{
  let a = fatal_alert(desc);
  return alert_to_record_bytes(&a);
}
