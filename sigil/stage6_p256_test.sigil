// ADR 0063 決定 6 段 6: P-256（secp256r1）の鍵交換の試験。
//
// 公開ベクタ: Botan の RFC 8448 再現トランスクリプト（Botan の src/tests/data/tls_13_rfc8448/transcripts.vec の
// HelloRetryRequest_Handshake 節。クライアントが x25519 の key_share だけを提示し、サーバーが P-256 を要求する例）。
// Botan のテストは両側の秘密鍵を固定の乱数列から作る。その乱数列（Server_RNG_Pool の 32〜63 バイト目、
// Client_RNG_Pool の 64〜95 バイト目）をスカラーとして点を求めると、トランスクリプトの公開点と一致する
// （独立に確認済み）。共有値は Python cryptography（OpenSSL）の ECDH でも同じ値になる。
// Record_ServerHandshakeMessages を、この共有値から導いた鍵で復号できる（AES-GCM の認証が通る）ので、
// 共有値・トランスクリプト・鍵スケジュールが一括で照合される。RFC 8448 の本文との直接照合は行っていない。

fn ecdsa_priv() -> Result<EcdsaP256PrivateKey, Int>
  intent "テスト用 ECDSA 秘密鍵"
  requires none
  ensures none
  effects none
{
  let key_raw = hex_decode("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721");
  return match EcdsaP256PrivateKey.from_secret(Secret.from_bytes(key_raw)) {
    Ok(k) => Ok(k),
    Err(_) => Err(90),
  };
}

fn x25519_priv() -> Result<X25519PrivateKey, Int>
  intent "テスト用 X25519 サーバー秘密鍵"
  requires none
  ensures none
  effects none
{
  let key_raw = hex_decode("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721");
  return match X25519PrivateKey.from_secret(Secret.from_bytes(key_raw)) {
    Ok(k) => Ok(k),
    Err(_) => Err(91),
  };
}

fn ecdh_priv(hex: String) -> Result<EcdhP256PrivateKey, Int>
  intent "テスト用 P-256 ECDH 秘密鍵を 16 進から作る"
  requires none
  ensures none
  effects none
{
  return match EcdhP256PrivateKey.from_secret(Secret.from_bytes(hex_decode(hex))) {
    Ok(k) => Ok(k),
    Err(_) => Err(92),
  };
}

