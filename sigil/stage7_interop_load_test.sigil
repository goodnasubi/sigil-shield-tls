            }
          }
        }
        Err(e) => {
          return e;
        }
      }
    }
    Err(e) => {
      return e;
    }
  }
}

fn test_interop_sni_and_alpn_rejections() -> Int
  intent "未登録 SNI および http/1.1 を含まない ALPN の拒絶（決定 1, 決定 2.4）試験"
  requires none
  ensures none
  effects none
{
  let priv_pem = get_test_pkcs8_pem();
  let chain_pem = get_test_fullchain_pem();
  let mut names = List.new();
  names.push("example.com");

  match load_bundle_from_pem_text(&chain_pem, &priv_pem, &names, Some(1748736000)) {
    Ok(bundle) => {
      let mut bundles = List.new();
      bundles.push(bundle);
      match new_certificate_store(bundles, None) {
        Ok(store) => {
          // 1. 未登録 SNI ("unknown.org") -> unrecognized_name (112)
          let unknown_sni = Some("unknown.org");
          match select_certificate_for_sni(&store, &unknown_sni) {
            Err(AlertDescription.UnrecognizedName) => {}
            _ => {
              return 502;
            }
          }
        }
        Err(_) => {
          return 501;
        }
      }

      // 2. 平文致命的アラートレコード構築の検証
      let alert_rec = build_plaintext_fatal_alert_record(&AlertDescription.UnrecognizedName);
      if alert_rec.byte_len() != 7 {
        return 503;
      }
      if alert_rec.get(0).unwrap_or(0) != 21 || alert_rec.get(5).unwrap_or(0) != 2 || alert_rec.get(6).unwrap_or(0) != 112 {
        return 504;
      }

      // 3. http/1.1 を含まない ALPN ("h2" のみ) -> no_application_protocol (120)
      match test_ecdsa_priv() {
        Ok(ecdsa_priv) => {
          let mut s_bundle = new_test_session(&ecdsa_priv);
          match test_client_x25519_priv() {
            Ok(c_xpriv) => {
              match test_server_x25519_priv() {
                Ok(s_xpriv) => {
                  let s_rand = hex_decode("707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f");
                  let mut ciphers = List.new();
                  ciphers.push(4865);
                  let mut groups = List.new();
                  groups.push(group_x25519());
                  let mut alpn_h2 = List.new();
                  alpn_h2.push("h2");

                  let ch_h2 = build_test_client_hello(ciphers, groups, group_x25519(), x25519_public_key(&c_xpriv).as_bytes(), alpn_h2, Some("example.com"), false);

                  return match handle_client_hello_explicit(&mut s_bundle, &ch_h2, &s_rand, &s_xpriv) {
                    Err(ShieldError.Fatal(AlertDescription.NoApplicationProtocol)) => 0,
                    _ => 507,
                  };
                }
                Err(e) => {
                  return e;
                }
              }
            }
            Err(e) => {
              return e;
            }
          }
        }
        Err(e) => {
          return e;
        }
      }
    }
    Err(_) => {
      return 501;
    }
  }
}

fn test_interop_proxy_v2_and_502() -> Int
  intent "PROXY protocol v2 ヘッダー付与・解析および 502 Bad Gateway 応答（決定 5.1, 5.3）試験"
  requires none
  ensures none
  effects none
{
  // 1. PROXY v2 ヘッダーの生成
  let src_ip = new_ipv4(192, 168, 1, 50);
  let dst_ip = new_ipv4(127, 0, 0, 1);
  let ep = ProxyEndpoint.IPv4(src_ip, 54321, dst_ip, 8443);
  let authority = Some("example.com");

  match build_proxy_v2_header(&ep, &authority) {
    Ok(proxy_hdr) => {
      // ADR 0063 決定 5.1: ヘッダー全体は 1 KiB 以下
      if proxy_hdr.byte_len() > 1024 {
        return 602;
      }

      // PROXY v2 解析照合
      match parse_proxy_v2_header(&proxy_hdr) {
        Ok(parsed) => {
          if !parsed_has_authority(&parsed) || parsed_authority(&parsed) != "example.com" {
            return 604;
          }
          if !parsed_has_ssl_tlv(&parsed) || parsed_ssl_version(&parsed) != "TLSv1.3" {
            return 605;
          }
          if parsed_src_port(&parsed) != 54321 || parsed_dst_port(&parsed) != 8443 {
            return 606;
          }

          // 2. 固定 502 Bad Gateway 応答と close_notify
          let bad_gw = build_502_bad_gateway_response();
          if bad_gw.byte_len() == 0 {
            return 607;
          }

          let suite = CipherSuite.TlsAes128GcmSha256;
          let mut dummy_sec = Bytes.new();
          let mut b = 0;
          while b < 32 {
            dummy_sec.push(b + 1);
            b = b + 1;
          }
          let mut prot = new_record_protection(RecordDirection.Transmit, suite, dummy_sec);
          match build_close_notify_record(&mut prot) {
            Ok(cn_rec) => {
              if cn_rec.byte_len() == 0 {
                return 609;
              }
              return 0;
            }
            Err(_) => {
              return 608;
            }
          }
        }
        Err(_) => {
          return 603;
        }
      }
    }
    Err(_) => {
      return 601;
    }
  }
}

pub fn main() -> Int
  intent "Stage 7 相互運用・負荷実測・公開前記録の全テストを実行する"
  requires none
  ensures none
  effects none
{
  let r1 = test_handshake_benchmark_x25519();
  if r1 != 0 {
    return r1;
  }

  let r2 = test_handshake_benchmark_p256();
  if r2 != 0 {
    return r2;
  }

  let r3 = test_interop_client_hello_openssl_variations();
  if r3 != 0 {
    return r3;
  }

  let r4 = test_interop_client_hello_curl_variations();
  if r4 != 0 {
    return r4;
  }

  let r5 = test_interop_sni_and_alpn_rejections();
  if r5 != 0 {
    return r5;
  }

  let r6 = test_interop_proxy_v2_and_502();
  if r6 != 0 {
    return r6;
  }

  return 0;
}
