          match test_client_x25519_priv() {
            Ok(c_xpriv) => {
              let c_xpub = x25519_public_key(&c_xpriv).as_bytes();
              let s_rand = hex_decode("707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f");
              let mut session = new_test_session(&ecdsa_priv);

              let mut ciphers = List.new();
              ciphers.push(4865);  // TLS_AES_128_GCM_SHA256
              ciphers.push(4866);  // TLS_AES_256_GCM_SHA384
              ciphers.push(4867);  // TLS_CHACHA20_POLY1305_SHA256

              let mut groups = List.new();
              groups.push(group_x25519());

              let mut alpn = List.new();
              alpn.push("http/1.1");

              let ch_msg = build_test_client_hello(ciphers, groups, group_x25519(), c_xpub, alpn, Some("example.com"), false);

              match handle_client_hello_explicit(&mut session, &ch_msg, &s_rand, &s_xpriv) {
                Ok(flight) => {
