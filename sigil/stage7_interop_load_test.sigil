fn test_ecdsa_priv() -> Result<EcdsaP256PrivateKey, Int>
  intent "テスト用 ECDSA 秘密鍵"
  requires none
  ensures none
  effects none
{
  let k_raw = hex_decode("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721");
  return match EcdsaP256PrivateKey.from_secret(Secret.from_bytes(k_raw)) {
    Ok(k) => Ok(k),
    Err(_) => Err(99),
  };
}

