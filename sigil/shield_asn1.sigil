module shield_asn1
  targets server
  trust none

// ASN.1 DER 厳密デコーダ（ADR 0063 決定 2.3）
// - DER の長さ・入れ子の厳格な検証（不正長・不定長 0x80・非最小長表現の拒否）
// - コンテナ内の余剰バイト（trailing bytes）の拒否

pub struct Asn1Element {
  tag: Int,
  header_len: Int,
  content_len: Int,
  total_len: Int,
  content: Bytes,
  raw: Bytes,
}

pub enum Asn1Error {
  UnexpectedEof,
  IndefiniteLengthForbidden,
  NonMinimalLengthEncoding,
  LengthOutOfRange,
  TrailingBytesInContainer,
  InvalidTag(Int),
  InvalidValue(String),
}

// 共通 ASN.1 タグ番号
pub fn tag_boolean() -> Int
  intent "BOOLEAN タグ (1)"
  requires none
  ensures none
  effects none
{
  return 1;
}

