pub fn read_element(data: &Bytes, offset: Int) -> Result<Asn1Element, Asn1Error>
  intent "DER バイト列から 1 つの ASN.1 要素を厳格に読み取る"
  requires none
  ensures none
  effects none
{
  let dlen = data.byte_len();
  if offset >= dlen {
    return Err(Asn1Error.UnexpectedEof);
  }

  let tag = data.get(offset).unwrap_or(0);
  if offset + 1 >= dlen {
    return Err(Asn1Error.UnexpectedEof);
  }

  let len_byte = data.get(offset + 1).unwrap_or(0);
  let mut content_len = 0;
  let mut header_len = 2;

  if len_byte < 128 {
    // 短縮形: 0..127
    content_len = len_byte;
    header_len = 2;
  } else if len_byte == 128 {
    // 不定長 (0x80) は DER では禁止
    return Err(Asn1Error.IndefiniteLengthForbidden);
  } else if len_byte == 255 {
    // 0xFF は予約・不正
    return Err(Asn1Error.LengthOutOfRange);
  } else {
    // 拡張形 (0x81..0x84)
    let num_octets = len_byte & 127;
    if num_octets < 1 || num_octets > 4 {
      return Err(Asn1Error.LengthOutOfRange);
    }
    if offset + 2 + num_octets > dlen {
      return Err(Asn1Error.UnexpectedEof);
    }

    // 非最小長エンコーディングの検証: 先頭バイトが 0x00 であってはならない
    let first_len_octet = data.get(offset + 2).unwrap_or(0);
    if first_len_octet == 0 {
      return Err(Asn1Error.NonMinimalLengthEncoding);
    }

    let mut parsed_len = 0;
    let mut i = 0;
    while i < num_octets {
      let b = data.get(offset + 2 + i).unwrap_or(0);
      parsed_len = parsed_len * 256 + b;
      i = i + 1;
    }

    // 1 オクテット拡張形で値が 128 未満の場合は短縮形を使うべきなので非最小長
    if num_octets == 1 && parsed_len < 128 {
      return Err(Asn1Error.NonMinimalLengthEncoding);
    }

    content_len = parsed_len;
    header_len = 2 + num_octets;
  }

  let total_len = header_len + content_len;
  if offset + total_len > dlen {
    return Err(Asn1Error.UnexpectedEof);
  }

  let mut raw_bytes = Bytes.new();
  match data.slice(offset, offset + total_len) {
    Ok(s) => {
      raw_bytes = s;
    }
    Err(_) => {
      return Err(Asn1Error.UnexpectedEof);
    }
  }

  let mut content_bytes = Bytes.new();
  match data.slice(offset + header_len, offset + total_len) {
    Ok(s) => {
      content_bytes = s;
    }
    Err(_) => {
      return Err(Asn1Error.UnexpectedEof);
    }
  }

  return Ok(Asn1Element { tag: tag, header_len: header_len, content_len: content_len, total_len: total_len, content: content_bytes, raw: raw_bytes });
}

pub fn read_children(container: &Asn1Element) -> Result<List<Asn1Element>, Asn1Error>
  intent "コンテナ要素の内容から子要素の一覧を厳格に読み取り、余剰バイトがないことを検証する"
  requires none
  ensures none
  effects none
{
  let mut children = List.new();
  let clen = container.content.byte_len();
  let mut offset = 0;

  while offset < clen {
    let elem = read_element(&container.content, offset)?;
    offset = offset + elem.total_len;
    children.push(elem);
  }

  if offset != clen {
    return Err(Asn1Error.TrailingBytesInContainer);
  }

  return Ok(children);
}

pub fn expect_tag(elem: &Asn1Element, expected: Int) -> Result<Bool, Asn1Error>
  intent "要素のタグが期待値と一致することを検証する"
  requires none
  ensures none
  effects none
{
  if elem.tag != expected {
    return Err(Asn1Error.InvalidTag(elem.tag));
  }
  return Ok(true);
}
