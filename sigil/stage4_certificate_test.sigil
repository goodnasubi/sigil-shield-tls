fn test_base64_strict() -> Int
  intent "Base64 厳格デコードのテスト（決定 2.1）"
  requires none
  ensures none
  effects none
{
  let res1 = base64_decode(&"YW55IGNhcm5hbCBwbGVhc3VyZS4=");
  match res1 {
    Ok(b) => {
      if b.byte_len() != 20 {
        return 101;
      }
    }
    Err(_) => {
      return 102;
    }
  }

  let res_bad_pad = base64_decode(&"ZE==");
  match res_bad_pad {
    Ok(_) => {
      return 103;
    }
    Err(_) => {}
  }

  let res_bad_char = base64_decode(&"YW55-GNh");
  match res_bad_char {
    Ok(_) => {
      return 104;
    }
    Err(_) => {}
  }

  let res_bad_len = base64_decode(&"Y");
  match res_bad_len {
    Ok(_) => {
      return 105;
    }
    Err(_) => {}
  }

  return 0;
}

fn test_pem_parser() -> Int
  intent "PEM 解析・暗号化鍵拒否・上限検査のテスト（決定 2.1）"
  requires none
  ensures none
  effects none
{
  let pkcs8 = get_p256_pkcs8_pem();
  let blocks_res = parse_pem(&pkcs8);
  match blocks_res {
    Ok(b) => {
      if b.len() != 1 {
        return 201;
      }
    }
    Err(_) => {
      return 202;
    }
  }

  let enc_pem1 = "-----BEGIN RSA PRIVATE KEY-----\nProc-Type: 4,ENCRYPTED\nDEK-Info: DES-EDE3-CBC,1234\n\nYW55\n-----END RSA PRIVATE KEY-----\n";
  let enc_res1 = parse_pem(&enc_pem1);
  match enc_res1 {
    Ok(_) => {
      return 203;
    }
    Err(e) => {
      match e {
        PemError.EncryptedKeyForbidden => {}
        _ => {
          return 204;
        }
      }
    }
  }

  let enc_pem2 = "-----BEGIN ENCRYPTED PRIVATE KEY-----\nYW55\n-----END ENCRYPTED PRIVATE KEY-----\n";
  let enc_res2 = parse_pem(&enc_pem2);
  match enc_res2 {
    Ok(_) => {
      return 205;
    }
    Err(e) => {
      match e {
        PemError.EncryptedKeyForbidden => {}
        _ => {
          return 206;
        }
      }
    }
  }

  return 0;
}

fn test_asn1_der_strict() -> Int
  intent "厳格 ASN.1 DER パーサーのテスト（決定 2.2, 2.3）"
  requires none
  ensures none
  effects none
{
  let mut indef = Bytes.new();
  indef.push(48);
  indef.push(128);
  indef.push(0);
  indef.push(0);
  let indef_res = read_element(&indef, 0);
  match indef_res {
    Ok(_) => {
      return 301;
    }
    Err(e) => {
      match e {
        Asn1Error.IndefiniteLengthForbidden => {}
        _ => {
          return 302;
        }
      }
    }
  }

  let mut non_min = Bytes.new();
  non_min.push(4);
  non_min.push(129);
  non_min.push(5);
  non_min.push(1);
  non_min.push(2);
  non_min.push(3);
  non_min.push(4);
  non_min.push(5);
  let non_min_res = read_element(&non_min, 0);
  match non_min_res {
    Ok(_) => {
      return 303;
    }
    Err(e) => {
      match e {
        Asn1Error.NonMinimalLengthEncoding => {}
        _ => {
          return 304;
        }
      }
    }
  }

  return 0;
}

fn test_private_key_parsing() -> Int
  intent "秘密鍵形式の判定とアルゴリズム検証（決定 2.2）"
  requires none
  ensures none
  effects none
{
  let pkcs8_pem = get_p256_pkcs8_pem();
  let blocks1 = parse_pem(&pkcs8_pem).unwrap_or(List.new());
  match blocks1.get(0) {
    Some(b1) => {
      match parse_private_key(&b1) {
        Ok(_) => {}
        Err(_) => {
          return 402;
        }
      }
    }
    None => {
      return 401;
    }
  }

  let sec1_pem = get_p256_sec1_pem();
  let blocks2 = parse_pem(&sec1_pem).unwrap_or(List.new());
  match blocks2.get(0) {
    Some(b2) => {
      match parse_private_key(&b2) {
        Ok(_) => {}
        Err(_) => {
          return 404;
        }
      }
    }
    None => {
      return 403;
    }
  }

  let rsa_pem = get_rsa_pem();
  let blocks_rsa = parse_pem(&rsa_pem).unwrap_or(List.new());
  match blocks_rsa.get(0) {
    Some(b_rsa) => {
      match parse_private_key(&b_rsa) {
        Ok(_) => {
          return 406;
        }
        Err(e) => {
          match e {
            CertError.UnsupportedAlgorithm(_) => {}
            _ => {
              return 407;
            }
          }
        }
      }
    }
    None => {
      return 405;
    }
  }

  let ed_pem = get_ed25519_pkcs8_pem();
  let blocks_ed = parse_pem(&ed_pem).unwrap_or(List.new());
  match blocks_ed.get(0) {
    Some(b_ed) => {
      match parse_private_key(&b_ed) {
        Ok(_) => {
          return 409;
        }
        Err(e) => {
          match e {
            CertError.UnsupportedAlgorithm(_) => {}
            _ => {
              return 410;
            }
          }
        }
      }
    }
    None => {
      return 408;
    }
  }

  let p384_pem = get_p384_pkcs8_pem();
  let blocks_p384 = parse_pem(&p384_pem).unwrap_or(List.new());
  match blocks_p384.get(0) {
    Some(b_p384) => {
      match parse_private_key(&b_p384) {
        Ok(_) => {
          return 412;
        }
        Err(e) => {
          match e {
            CertError.UnsupportedCurve(_) => {}
            _ => {
              return 413;
            }
          }
        }
      }
    }
    None => {
      return 411;
    }
  }

  return 0;
}

fn test_certificate_parsing_and_san() -> Int
  intent "X.509 証明書解析と SAN 抽出のテスト（決定 2.3）"
  requires none
  ensures none
  effects none
{
  let leaf_pem = get_leaf_cert_pem();
  let blocks = parse_pem(&leaf_pem).unwrap_or(List.new());
  match blocks.get(0) {
    Some(b) => {
      match parse_certificate(&b.data) {
        Ok(cert) => {
          if cert.san_dns_names.len() < 2 {
            return 503;
          }
          let mut has_exact = false;
          let mut has_wild = false;
          let mut i = 0;
          while i < cert.san_dns_names.len() {
            match cert.san_dns_names.get(i) {
              Some(name) => {
                if name == "example.com" {
                  has_exact = true;
                }
                if name == "*.example.com" {
                  has_wild = true;
                }
              }
              None => {}
            }
            i = i + 1;
          }
          if !has_exact || !has_wild {
            return 504;
          }
        }
        Err(_) => {
          return 502;
        }
      }
    }
    None => {
      return 501;
    }
  }

  return 0;
}

fn test_chain_validation() -> Int
  intent "証明書チェーンの検証・鍵照合・時刻判定のテスト（決定 2.3）"
  requires none
  ensures none
  effects none
{
  let fullchain = get_fullchain_pem();
  let key_pem = get_p256_pkcs8_pem();
  let other_key_pem = get_other_p256_pkcs8_pem();

  let mut names = List.new();
  names.push("example.com");

  let bundle_ok = load_bundle_from_pem_text(&fullchain, &key_pem, &names, Some(1748736000));
  match bundle_ok {
    Ok(_) => {}
    Err(_) => {
      return 601;
    }
  }

  let bundle_no_clock = load_bundle_from_pem_text(&fullchain, &key_pem, &names, None);
  match bundle_no_clock {
    Ok(_) => {
      return 602;
    }
    Err(e) => {
      match e {
        CertError.ClockUnavailable => {}
        _ => {
          return 603;
        }
      }
    }
  }

  let bundle_expired = load_bundle_from_pem_text(&fullchain, &key_pem, &names, Some(2000000000));
  match bundle_expired {
    Ok(_) => {
      return 604;
    }
    Err(e) => {
      match e {
        CertError.CertificateExpired(_, _) => {}
        _ => {
          return 605;
        }
      }
    }
  }

  let bundle_future = load_bundle_from_pem_text(&fullchain, &key_pem, &names, Some(1000));
  match bundle_future {
    Ok(_) => {
      return 606;
    }
    Err(e) => {
      match e {
        CertError.CertificateNotYetValid(_, _) => {}
        _ => {
          return 607;
        }
      }
    }
  }

  let bundle_mismatch_key = load_bundle_from_pem_text(&fullchain, &other_key_pem, &names, Some(1748736000));
  match bundle_mismatch_key {
    Ok(_) => {
      return 608;
    }
    Err(e) => {
      match e {
        CertError.PublicKeyMismatch => {}
        _ => {
          return 609;
        }
      }
    }
  }

  let mut bad_names = List.new();
  bad_names.push("otherdomain.org");
  let bundle_bad_san = load_bundle_from_pem_text(&fullchain, &key_pem, &bad_names, Some(1748736000));
  match bundle_bad_san {
    Ok(_) => {
      return 610;
    }
    Err(e) => {
      match e {
        CertError.ConfiguredNameNotCovered(_) => {}
        _ => {
          return 611;
        }
      }
    }
  }

  // P-384 中間 CA を持つ P-256 リーフ証明書チェーンの受理テスト（P2 指摘 2）
  let p384_chain = get_p384_ca_chain_pem();
  let mut p384_names = List.new();
  p384_names.push("p384ca.example.com");
  let bundle_p384_ca = load_bundle_from_pem_text(&p384_chain, &key_pem, &p384_names, Some(1748736000));
  match bundle_p384_ca {
    Ok(_) => {}
    Err(_) => {
      return 612;
    }
  }

  return 0;
}

fn test_hostname_and_sni() -> Int
  intent "ホスト名の正規化・ワイルドカード照合・SNI 選択（決定 2.4）"
  requires none
  ensures none
  effects none
{
  let norm_res = normalize_hostname(&"Example.COM");
  match norm_res {
    Ok(h) => {
      if h != "example.com" {
        return 701;
      }
    }
    Err(_) => {
      return 702;
    }
  }

  let dot_res = normalize_hostname(&"example.com.");
  match dot_res {
    Ok(_) => {
      return 703;
    }
    Err(_) => {}
  }

  let ip4_res = normalize_hostname(&"192.168.1.1");
  match ip4_res {
    Ok(_) => {
      return 704;
    }
    Err(_) => {}
  }
  let ip6_res = normalize_hostname(&"::1");
  match ip6_res {
    Ok(_) => {
      return 705;
    }
    Err(_) => {}
  }

  if !match_san_pattern(&"*.example.com", &"foo.example.com") {
    return 706;
  }
  if match_san_pattern(&"*.example.com", &"example.com") {
    return 707;
  }
  if match_san_pattern(&"*.example.com", &"bar.foo.example.com") {
    return 708;
  }

  let fullchain = get_fullchain_pem();
  let key_pem = get_p256_pkcs8_pem();
  let mut names = List.new();
  names.push("example.com");
  names.push("*.example.com");

  match load_bundle_from_pem_text(&fullchain, &key_pem, &names, Some(1748736000)) {
    Ok(bundle) => {
      let mut bundles = List.new();
      bundles.push(bundle);

      match new_certificate_store(bundles, Some("example.com")) {
        Ok(store) => {
          match select_certificate_for_sni(&store, &Some("example.com")) {
            Ok(idx) => {
              if idx != 0 {
                return 711;
              }
            }
            Err(_) => {
              return 712;
            }
          }

          match select_certificate_for_sni(&store, &Some("sub.example.com")) {
            Ok(idx) => {
              if idx != 0 {
                return 713;
              }
            }
            Err(_) => {
              return 714;
            }
          }

          match select_certificate_for_sni(&store, &Some("unknown.org")) {
            Ok(_) => {
              return 715;
            }
            Err(a) => {
              match a {
                AlertDescription.UnrecognizedName => {}
                _ => {
                  return 716;
                }
              }
            }
          }

          match select_certificate_for_sni(&store, &None) {
            Ok(idx) => {
              if idx != 0 {
                return 717;
              }
            }
            Err(_) => {
              return 718;
            }
          }
        }
        Err(_) => {
          return 710;
        }
      }
    }
    Err(_) => {
      return 709;
    }
  }

  // 混合ケース設定名の正規化と SNI 選択・default_server_name 照合（P2 指摘 1）
  let mut mixed_names = List.new();
  mixed_names.push("WWW.example.com");

  match load_bundle_from_pem_text(&fullchain, &key_pem, &mixed_names, Some(1748736000)) {
    Ok(mixed_bundle) => {
      let mut mixed_bundles = List.new();
      mixed_bundles.push(mixed_bundle);

      match new_certificate_store(mixed_bundles, Some("WWW.example.com")) {
        Ok(mixed_store) => {
          // 小文字のクライアント SNI で一致すること
          match select_certificate_for_sni(&mixed_store, &Some("www.example.com")) {
            Ok(idx) => {
              if idx != 0 {
                return 719;
              }
            }
            Err(_) => {
              return 720;
            }
          }

          // 混合ケースのクライアント SNI でも一致すること
          match select_certificate_for_sni(&mixed_store, &Some("WWW.example.com")) {
            Ok(idx) => {
              if idx != 0 {
                return 721;
              }
            }
            Err(_) => {
              return 722;
            }
          }

          // SNI なし時に正規化された default_server_name で一致すること
          match select_certificate_for_sni(&mixed_store, &None) {
            Ok(idx) => {
              if idx != 0 {
                return 723;
              }
            }
            Err(_) => {
              return 724;
            }
          }
        }
        Err(_) => {
          return 725;
        }
      }
    }
    Err(_) => {
      return 726;
    }
  }

  // 混合ケースでの重複名検査（WWW.example.com と www.example.com）
  let mut dup_names1 = List.new();
  dup_names1.push("WWW.example.com");
  match load_bundle_from_pem_text(&fullchain, &key_pem, &dup_names1, Some(1748736000)) {
    Ok(b_dup1) => {
      let mut dup_names2 = List.new();
      dup_names2.push("www.example.com");
      match load_bundle_from_pem_text(&fullchain, &key_pem, &dup_names2, Some(1748736000)) {
        Ok(b_dup2) => {
          let mut dup_bundles = List.new();
          dup_bundles.push(b_dup1);
          dup_bundles.push(b_dup2);
          match new_certificate_store(dup_bundles, None) {
            Ok(_) => {
              return 727;
            }
            Err(e) => {
              match e {
                CertError.DuplicateConfiguredName(_) => {}
                _ => {
                  return 728;
                }
              }
            }
          }
        }
        Err(_) => {
          return 729;
        }
      }
    }
    Err(_) => {
      return 730;
    }
  }

  return 0;
}

