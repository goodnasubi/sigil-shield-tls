fn test_fuzz_pem_and_asn1() -> Int
  intent "PEM と ASN.1 パーサーの変異ファジング（パニックせず正常にエラーを返すこと）"
  requires none
  ensures none
  effects none
{
  let mut rng = 123456789;
  let mut i = 0;
  while i < 50 {
    let mut buf = Bytes.new();
    let len = rng % 128 + 1;
    let mut j = 0;
    while j < len {
      rng = (rng * 1103515245 + 12345) % 2147483648;
      buf.push(rng % 256);
      j = j + 1;
    }

    let _ = read_element(&buf, 0);
    let _ = parse_pem(&"-----BEGIN CERTIFICATE-----\nmalformed\n-----END CERTIFICATE-----");

    i = i + 1;
  }

  return 0;
}

