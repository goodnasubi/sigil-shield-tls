  let m777 = validate_file_mode(511);
  match m777 {
    Ok(_) => {
      return 805;
    }
    Err(_) => {}
  }

  return 0;
}

fn test_expiry_warning() -> Int
  intent "証明書の有効期限警告（決定 2.3）"
  requires none
  ensures none
  effects none
{
  let fullchain = get_fullchain_pem();
  let key_pem = get_p256_pkcs8_pem();
  let mut names = List.new();
  names.push("example.com");

  match load_bundle_from_pem_text(&fullchain, &key_pem, &names, Some(1748736000)) {
    Ok(bundle) => {
      let st1 = check_expiry(&bundle, 1748736000);
      match st1 {
        ExpiryStatus.Valid => {}
        _ => {
          return 902;
        }
      }

      let st2 = check_expiry(&bundle, 1830297600 - 604800);
      match st2 {
        ExpiryStatus.ExpiringSoon(s) => {
          if s != 604800 {
            return 903;
          }
        }
        _ => {
          return 904;
        }
      }

      let st3 = check_expiry(&bundle, 1830297600 + 86400);
      match st3 {
        ExpiryStatus.Expired(s) => {
          if s != 86400 {
            return 905;
          }
        }
        _ => {
          return 906;
        }
      }
    }
    Err(_) => {
      return 901;
    }
  }

  return 0;
}

fn test_store_reload() -> Int
  intent "原子的な証明書ストア再読み込みとロールバック（決定 2.5）"
  requires none
  ensures none
  effects none
{
  let mut mgr = new_store_manager();

  let fullchain = get_fullchain_pem();
  let key_pem = get_p256_pkcs8_pem();
  let mut names = List.new();
  names.push("example.com");

  match load_bundle_from_pem_text(&fullchain, &key_pem, &names, Some(1748736000)) {
    Ok(bundle) => {
      let mut initial_bundles = List.new();
      initial_bundles.push(bundle);

      let r1 = reload_store(&mut mgr, initial_bundles, Some("example.com"));
      match r1 {
        Ok(outcome) => {
          match outcome {
            ReloadOutcome.Success => {}
            _ => {
              return 1002;
            }
          }
        }
        Err(_) => {
          return 1003;
        }
      }

      let r2 = reload_store(&mut mgr, List.new(), Some("example.com"));
      match r2 {
        Ok(outcome) => {
          match outcome {
            ReloadOutcome.PreservedPrevious(_) => {}
            _ => {
              return 1004;
            }
          }
        }
        Err(_) => {
          return 1005;
        }
      }

      match mgr.current_store {
        Some(cur_store) => {
          match select_certificate_for_sni(&cur_store, &Some("example.com")) {
            Ok(idx) => {
              if idx != 0 {
                return 1007;
              }
            }
            Err(_) => {
              return 1008;
            }
          }
        }
        None => {
          return 1006;
        }
      }
    }
    Err(_) => {
      return 1001;
    }
  }

  return 0;
}

