  intent "テスト用 P-256 PKCS#8 秘密鍵 PEM"
  requires none
  ensures none
  effects none
{
  return "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgEYGnSiBgXwP7WZEK\nnW83yc235VtOZqeK/Q82a2KsKzChRANCAAQsjimmI6QJfZtzEjO7tDVwEdD3FDaG\nFNceg/i8+Od5h4vee9/+QglHMgchn7hqguuMfQgPiyd39KnTRghFUJse\n-----END PRIVATE KEY-----\n";
}

