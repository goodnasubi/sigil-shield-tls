module stage7_interop_server
  targets server
  trust none

use shield_certificate.CertificateStore;
use shield_certificate.create_session_for_bundle;
use shield_certificate.load_bundle_from_pem_text;
use shield_certificate.new_certificate_store;
use shield_certificate.select_certificate_for_sni;
use shield_client_hello.ServerName;
use shield_client_hello.client_hello_server_name;
use shield_client_hello.parse_client_hello;
use shield_handshake.HandshakePhase;
use shield_handshake.flight_records;
use shield_handshake.handle_client_hello_explicit;
use shield_handshake.handle_client_record;
use shield_handshake.handshake_client_app_protection;
use shield_handshake.handshake_phase;
use shield_handshake.handshake_server_app_protection;
use shield_handshake.handshake_set_p256_key;
use shield_record.ContentType;
use shield_record_crypto.open_outcome_plaintext;
use shield_record_crypto.open_record;
use shield_record_crypto.seal_record;
use shield_relay.build_close_notify_record;
use shield_relay.build_plaintext_fatal_alert_record;
use test_support.hex_decode;

// ADR 0063 段 7: 外部 TLS クライアント（curl, openssl s_client）相互運用試験用サーバー

