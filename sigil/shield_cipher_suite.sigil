module shield_cipher_suite
  targets server
  trust none

use shield_alert.AlertDescription;
use shield_alert.ShieldError;

// 暗号スイート定義と選択（ADR 0063 決定 1, RFC 8446 §B.4）
//
// 3 スイート対応:
// - TLS_CHACHA20_POLY1305_SHA256 (0x1303)
// - TLS_AES_128_GCM_SHA256 (0x1301)
// - TLS_AES_256_GCM_SHA384 (0x1302)
//
// サーバー優先順: ChaCha20-Poly1305 > AES-128-GCM > AES-256-GCM

pub enum CipherSuite {
  TlsChacha20Poly1305Sha256,
  TlsAes128GcmSha256,
  TlsAes256GcmSha384,
}

pub fn tls_aes_128_gcm_sha256_code() -> Int
  intent "TLS_AES_128_GCM_SHA256 のスイートコード（0x1301）"
  requires none
  ensures none
  effects none
{
  return 4865;
}

pub fn tls_aes_256_gcm_sha384_code() -> Int
  intent "TLS_AES_256_GCM_SHA384 のスイートコード（0x1302）"
  requires none
  ensures none
  effects none
{
  return 4866;
}

pub fn tls_chacha20_poly1305_sha256_code() -> Int
  intent "TLS_CHACHA20_POLY1305_SHA256 のスイートコード（0x1303）"
  requires none
  ensures none
  effects none
{
  return 4867;
}

pub fn cipher_suite_from_u16(code: Int) -> Option<CipherSuite>
  intent "16 ビット整数コードから CipherSuite を復元する"
  requires none
  ensures none
  effects none
{
  if code == 4867 {
    return Some(CipherSuite.TlsChacha20Poly1305Sha256);
  }
  if code == 4865 {
    return Some(CipherSuite.TlsAes128GcmSha256);
  }
  if code == 4866 {
    return Some(CipherSuite.TlsAes256GcmSha384);
  }
  return None;
}

pub fn cipher_suite_to_u16(suite: &CipherSuite) -> Int
  intent "CipherSuite を 16 ビット整数コードに変換する"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => 4867,
    CipherSuite.TlsAes128GcmSha256 => 4865,
    CipherSuite.TlsAes256GcmSha384 => 4866,
  };
}

pub fn cipher_suite_name(suite: &CipherSuite) -> String
  intent "CipherSuite の文字列表現を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => "TLS_CHACHA20_POLY1305_SHA256",
    CipherSuite.TlsAes128GcmSha256 => "TLS_AES_128_GCM_SHA256",
    CipherSuite.TlsAes256GcmSha384 => "TLS_AES_256_GCM_SHA384",
  };
}

pub fn cipher_suite_key_len(suite: &CipherSuite) -> Int
  intent "AEAD 鍵長（バイト）を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => 32,
    CipherSuite.TlsAes128GcmSha256 => 16,
    CipherSuite.TlsAes256GcmSha384 => 32,
  };
}

pub fn cipher_suite_iv_len(suite: &CipherSuite) -> Int
  intent "AEAD IV 長（バイト、TLS 1.3 では常に 12 バイト）を返す"
  requires none
  ensures none
  effects none
{
  return 12;
}

pub fn cipher_suite_tag_len(suite: &CipherSuite) -> Int
  intent "AEAD 認証タグ長（バイト、常に 16 バイト）を返す"
  requires none
  ensures none
  effects none
{
  return 16;
}

pub fn cipher_suite_hash_len(suite: &CipherSuite) -> Int
  intent "ハッシュ出力長（バイト）を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => 32,
    CipherSuite.TlsAes128GcmSha256 => 32,
    CipherSuite.TlsAes256GcmSha384 => 48,
  };
}

pub fn select_cipher_suite(client_suites: &List<Int>) -> Result<CipherSuite, ShieldError>
  intent "クライアント提示スイート一覧からサーバー優先順に基づき最初の 1 つを選択する"
  requires none
  ensures none
  effects none
{
  // サーバー優先順 1: ChaCha20-Poly1305 (4867)
  let mut i = 0;
  while i < client_suites.len() {
    if client_suites.get(i).map(|x| x + 0).unwrap_or(0) == 4867 {
      return Ok(CipherSuite.TlsChacha20Poly1305Sha256);
    }
    i = i + 1;
  }

  // サーバー優先順 2: AES-128-GCM (4865)
  i = 0;
  while i < client_suites.len() {
    if client_suites.get(i).map(|x| x + 0).unwrap_or(0) == 4865 {
      return Ok(CipherSuite.TlsAes128GcmSha256);
    }
    i = i + 1;
  }

  // サーバー優先順 3: AES-256-GCM (4866)
  i = 0;
  while i < client_suites.len() {
    if client_suites.get(i).map(|x| x + 0).unwrap_or(0) == 4866 {
      return Ok(CipherSuite.TlsAes256GcmSha384);
    }
    i = i + 1;
  }

  return Err(ShieldError.Fatal(AlertDescription.HandshakeFailure));
}

pub fn aead_seal(suite: &CipherSuite, key: &Bytes, nonce_bytes: &Bytes, aad: &Bytes, plaintext: &Bytes) -> Result<Bytes, ShieldError>
  intent "AEAD 暗号化を行い暗号文と 16 バイト認証タグの連結バイト列を返す"
  requires none
  ensures none
  effects none
{
  match Nonce96.from_slice(&nonce_bytes) {
    Err(_) => {
      return Err(ShieldError.Fatal(AlertDescription.InternalError));
    }
    Ok(nonce) => {
      let secret_pt = Secret.from_bytes(plaintext.clone());
      return match suite {
        CipherSuite.TlsChacha20Poly1305Sha256 => match ChaCha20Poly1305Key.from_secret(Secret.from_bytes(key.clone())) {
          Err(_) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
          Ok(k) => match chacha20_poly1305_seal(&k, nonce, &aad, &secret_pt) {
            Ok(ct) => Ok(ct),
            Err(_) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
          },
        },
        CipherSuite.TlsAes128GcmSha256 => match Aes128GcmKey.from_secret(Secret.from_bytes(key.clone())) {
          Err(_) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
          Ok(k) => match aes128_gcm_seal(&k, nonce, &aad, &secret_pt) {
            Ok(ct) => Ok(ct),
            Err(_) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
          },
        },
        CipherSuite.TlsAes256GcmSha384 => match Aes256GcmKey.from_secret(Secret.from_bytes(key.clone())) {
          Err(_) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
          Ok(k) => match aes256_gcm_seal(&k, nonce, &aad, &secret_pt) {
            Ok(ct) => Ok(ct),
            Err(_) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
          },
        },
      };
    }
  }
}

pub fn aead_open(suite: &CipherSuite, key: &Bytes, nonce_bytes: &Bytes, aad: &Bytes, ciphertext_and_tag: &Bytes) -> Result<Bytes, ShieldError>
  intent "AEAD 復号とタグ検証を行い成功時に平文バイト列を返す。失敗時は bad_record_mac"
  requires none
  ensures none
  effects none
{
  return match Nonce96.from_slice(&nonce_bytes) {
    Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
    Ok(nonce) => match suite {
      CipherSuite.TlsChacha20Poly1305Sha256 => match ChaCha20Poly1305Key.from_secret(Secret.from_bytes(key.clone())) {
        Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
        Ok(k) => match chacha20_poly1305_open(&k, &nonce, &aad, &ciphertext_and_tag) {
          Ok(pt_secret) => Ok(pt_secret.expose()),
          Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
        },
      },
      CipherSuite.TlsAes128GcmSha256 => match Aes128GcmKey.from_secret(Secret.from_bytes(key.clone())) {
        Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
        Ok(k) => match aes128_gcm_open(&k, &nonce, &aad, &ciphertext_and_tag) {
          Ok(pt_secret) => Ok(pt_secret.expose()),
          Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
        },
      },
      CipherSuite.TlsAes256GcmSha384 => match Aes256GcmKey.from_secret(Secret.from_bytes(key.clone())) {
        Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
        Ok(k) => match aes256_gcm_open(&k, &nonce, &aad, &ciphertext_and_tag) {
          Ok(pt_secret) => Ok(pt_secret.expose()),
          Err(_) => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
        },
      },
    },
  };
}
