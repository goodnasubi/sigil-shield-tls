module shield_cipher_suite
  targets server
  trust none

use shield_alert.AlertDescription;
use shield_alert.ShieldError;

// TLS 1.3 暗号スイート定義と選択（ADR 0063 決定 1, RFC 8446 §B.4）
//
// 3 スイート対応:
// - TLS_CHACHA20_POLY1305_SHA256 (0x1303)
// - TLS_AES_128_GCM_SHA256 (0x1301)
// - TLS_AES_256_GCM_SHA384 (0x1302)
//
// サーバー優先順: ChaCha20-Poly1305 > AES-128-GCM > AES-256-GCM

pub enum CipherSuite {
  TlsChacha20Poly1305Sha256,
  TlsAes128GcmSha256,
  TlsAes256GcmSha384,
}

pub fn cipher_suite_code_chacha20_poly1305_sha256() -> Int
  intent "TLS_CHACHA20_POLY1305_SHA256 (0x1303)"
  requires none
  ensures none
  effects none
{
  return 4867;
}

pub fn cipher_suite_code_aes_128_gcm_sha256() -> Int
  intent "TLS_AES_128_GCM_SHA256 (0x1301)"
  requires none
  ensures none
  effects none
{
  return 4865;
}

pub fn cipher_suite_code_aes_256_gcm_sha384() -> Int
  intent "TLS_AES_256_GCM_SHA384 (0x1302)"
  requires none
  ensures none
  effects none
{
  return 4866;
}

pub fn cipher_suite_from_u16(code: Int) -> Option<CipherSuite>
  intent "スイート番号から暗号スイートを取得する"
  requires none
  ensures none
  effects none
{
  if code == 4867 {
    return Some(CipherSuite.TlsChacha20Poly1305Sha256);
  }
  if code == 4865 {
    return Some(CipherSuite.TlsAes128GcmSha256);
  }
  if code == 4866 {
    return Some(CipherSuite.TlsAes256GcmSha384);
  }
  return None;
}

pub fn cipher_suite_as_u16(suite: &CipherSuite) -> Int
  intent "暗号スイートの 16 ビット識別子を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => 4867,
    CipherSuite.TlsAes128GcmSha256 => 4865,
    CipherSuite.TlsAes256GcmSha384 => 4866,
  };
}

pub fn cipher_suite_name(suite: &CipherSuite) -> String
  intent "暗号スイートの名前を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => "TLS_CHACHA20_POLY1305_SHA256",
    CipherSuite.TlsAes128GcmSha256 => "TLS_AES_128_GCM_SHA256",
    CipherSuite.TlsAes256GcmSha384 => "TLS_AES_256_GCM_SHA384",
  };
}

pub fn cipher_suite_key_len(suite: &CipherSuite) -> Int
  intent "AEAD 鍵長（バイト）を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => 32,
    CipherSuite.TlsAes128GcmSha256 => 16,
    CipherSuite.TlsAes256GcmSha384 => 32,
  };
}

pub fn cipher_suite_iv_len(suite: &CipherSuite) -> Int
  intent "AEAD IV 長（バイト、TLS 1.3 では常に 12 バイト）を返す"
  requires none
  ensures none
  effects none
{
  return 12;
}

pub fn cipher_suite_tag_len(suite: &CipherSuite) -> Int
  intent "AEAD 認証タグ長（バイト、常に 16 バイト）を返す"
  requires none
  ensures none
  effects none
{
  return 16;
}

pub fn cipher_suite_hash_len(suite: &CipherSuite) -> Int
  intent "ハッシュ出力長（バイト）を返す"
  requires none
  ensures none
  effects none
{
  return match suite {
    CipherSuite.TlsChacha20Poly1305Sha256 => 32,
    CipherSuite.TlsAes128GcmSha256 => 32,
    CipherSuite.TlsAes256GcmSha384 => 48,
  };
}

pub fn select_cipher_suite(client_suites: &List<Int>) -> Result<CipherSuite, ShieldError>
  intent "クライアント提示スイート一覧からサーバー優先順で最初の 1 つを選択する"
  requires none
  ensures none
  effects none
{
  // サーバー優先順: ChaCha20-Poly1305 > AES-128-GCM > AES-256-GCM (ADR 0063 決定 1)
  let chacha_code = cipher_suite_code_chacha20_poly1305_sha256();
  let mut i = 0;
  while i < client_suites.len() {
    let c = client_suites.get(i).map(|x| x + 0).unwrap_or(0);
    if c == chacha_code {
      return Ok(CipherSuite.TlsChacha20Poly1305Sha256);
    }
    i = i + 1;
  }

  let aes128_code = cipher_suite_code_aes_128_gcm_sha256();
  let mut j = 0;
  while j < client_suites.len() {
    let c = client_suites.get(j).map(|x| x + 0).unwrap_or(0);
    if c == aes128_code {
      return Ok(CipherSuite.TlsAes128GcmSha256);
    }
    j = j + 1;
  }

  let aes256_code = cipher_suite_code_aes_256_gcm_sha384();
  let mut k = 0;
  while k < client_suites.len() {
    let c = client_suites.get(k).map(|x| x + 0).unwrap_or(0);
    if c == aes256_code {
      return Ok(CipherSuite.TlsAes256GcmSha384);
    }
    k = k + 1;
  }

  return Err(ShieldError.Fatal(AlertDescription.HandshakeFailure));
}

pub fn cipher_suite_seal(suite: &CipherSuite, key: &Secret, iv: &Bytes, aad: &Bytes, plaintext: &Secret) -> Result<Bytes, ShieldError>
  intent "暗号スイートに応じた AEAD 暗号化を行う"
  requires none
  ensures none
  effects none
{
  return match Nonce96.from_slice(&iv) {
    Ok(nonce) => match suite {
      CipherSuite.TlsChacha20Poly1305Sha256 => match ChaCha20Poly1305Key.from_secret(key.clone()) {
        Ok(k) => match chacha20_poly1305_seal(&k, nonce, &aad, &plaintext) {
          Ok(ct) => Ok(ct),
          Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
        },
        Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
      },
      CipherSuite.TlsAes128GcmSha256 => match Aes128GcmKey.from_secret(key.clone()) {
        Ok(k) => match aes128_gcm_seal(&k, nonce, &aad, &plaintext) {
          Ok(ct) => Ok(ct),
          Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
        },
        Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
      },
      CipherSuite.TlsAes256GcmSha384 => match Aes256GcmKey.from_secret(key.clone()) {
        Ok(k) => match aes256_gcm_seal(&k, nonce, &aad, &plaintext) {
          Ok(ct) => Ok(ct),
          Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
        },
        Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
      },
    },
    Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
  };
}

pub fn cipher_suite_open(suite: &CipherSuite, key: &Secret, iv: &Bytes, aad: &Bytes, ciphertext_and_tag: &Bytes) -> Result<Secret, ShieldError>
  intent "暗号スイートに応じた AEAD 復号および認証を行う"
  requires none
  ensures none
  effects none
{
  return match Nonce96.from_slice(&iv) {
    Ok(nonce) => match suite {
      CipherSuite.TlsChacha20Poly1305Sha256 => match ChaCha20Poly1305Key.from_secret(key.clone()) {
        Ok(k) => match chacha20_poly1305_open(&k, &nonce, &aad, &ciphertext_and_tag) {
          Ok(pt) => Ok(pt),
          Err(e) => match e {
            AeadError.AuthenticationFailed => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
            _ => Err(ShieldError.Fatal(AlertDescription.DecodeError)),
          },
        },
        Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
      },
      CipherSuite.TlsAes128GcmSha256 => match Aes128GcmKey.from_secret(key.clone()) {
        Ok(k) => match aes128_gcm_open(&k, &nonce, &aad, &ciphertext_and_tag) {
          Ok(pt) => Ok(pt),
          Err(e) => match e {
            AeadError.AuthenticationFailed => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
            _ => Err(ShieldError.Fatal(AlertDescription.DecodeError)),
          },
        },
        Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
      },
      CipherSuite.TlsAes256GcmSha384 => match Aes256GcmKey.from_secret(key.clone()) {
        Ok(k) => match aes256_gcm_open(&k, &nonce, &aad, &ciphertext_and_tag) {
          Ok(pt) => Ok(pt),
          Err(e) => match e {
            AeadError.AuthenticationFailed => Err(ShieldError.Fatal(AlertDescription.BadRecordMac)),
            _ => Err(ShieldError.Fatal(AlertDescription.DecodeError)),
          },
        },
        Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
      },
    },
    Err(e) => Err(ShieldError.Fatal(AlertDescription.InternalError)),
  };
}
